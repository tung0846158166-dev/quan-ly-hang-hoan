{
  "name": "quan-ly-hang-hoan",
  "version": "1.5.0",
  "description": "Phan mem Quan Ly va Doi Soat Hang Hoan Shopee - TikTok Shop",
  "main": "main.js",
  "author": "Shop Owner",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 -p never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.shop.quanlyhanghoan",
    "productName": "Quan Ly Hang Hoan",
    "publish": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "Bang_Excel_Quan_Ly_Hang_Hoan_Tu_Dong_Thu_Nho_Anh.html",
      "mobile_scanner.html",
      "app_icon.ico",
      "app_icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "app_icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quan Ly Hang Hoan",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}