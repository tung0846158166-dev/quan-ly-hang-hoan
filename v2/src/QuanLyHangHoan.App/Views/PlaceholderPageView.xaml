<UserControl x:Class="QuanLyHangHoan.App.Views.PlaceholderPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             xmlns:conv="clr-namespace:QuanLyHangHoan.App.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlaceholderPageViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <conv:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                    <Border Background="{DynamicResource InfoBlueBadgeBgBrush}" BorderBrush="{DynamicResource InfoBlueCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InfoBlueTextBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Subtitle}" FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Preview Table Card -->
        <Border Grid.Row="1" Margin="18,14" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource AlertYellowCardBgBrush}" BorderBrush="{DynamicResource AlertYellowCardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                    <TextBlock Text="ℹ️ Màn hình khung (T002) hiển thị vài dòng dữ liệu giả minh họa cấu trúc cột; logic nghiệp vụ &amp; SQLite sẽ được nối ở các phiếu tiếp theo."
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AlertYellowTextBrush}"
                               TextWrapping="Wrap" />
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding SampleRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                          BorderThickness="0"
                          Background="{DynamicResource DataGridBgBrush}"
                          RowStyle="{StaticResource ThemeDataGridRowStyle}"
                          RowHeight="38"
                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                          CellStyle="{StaticResource ModernDataGridCellStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Data.Col1Header, Source={StaticResource VmProxy}}" Binding="{Binding Col1}" Width="180" />
                        <DataGridTextColumn Header="{Binding Data.Col2Header, Source={StaticResource VmProxy}}" Binding="{Binding Col2}" Width="180" />
                        <DataGridTextColumn Header="{Binding Data.Col3Header, Source={StaticResource VmProxy}}" Binding="{Binding Col3}" Width="210" />
                        <DataGridTextColumn Header="{Binding Data.Col4Header, Source={StaticResource VmProxy}}" Binding="{Binding Col4}" Width="200" />
                        <DataGridTextColumn Header="{Binding Data.Col5Header, Source={StaticResource VmProxy}}" Binding="{Binding Col5}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer Note -->
        <Border Grid.Row="2" Background="{DynamicResource SidebarBgBrush}" Padding="18,9">
            <TextBlock Text="{Binding FooterNote}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="12" />
        </Border>
    </Grid>
</UserControl>
