<Window x:Class="QuanLyHangHoan.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
        xmlns:views="clr-namespace:QuanLyHangHoan.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Width="1360"
        Height="820"
        MinWidth="1024"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReturnOrdersViewModel}">
            <views:ReturnOrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArchivedOrdersViewModel}">
            <views:ArchivedOrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NewOrdersViewModel}">
            <views:NewOrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReturnWatchViewModel}">
            <views:ReturnWatchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WatchlistViewModel}">
            <views:WatchlistView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeletedOrdersViewModel}">
            <views:DeletedOrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StatisticsViewModel}">
            <views:StatisticsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LegacyImportViewModel}">
            <views:LegacyImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanReceiveViewModel}">
            <views:ScanReceiveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PhoneSyncViewModel}">
            <views:PhoneSyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FolderWatchViewModel}">
            <views:FolderWatchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FileImportViewModel}">
            <views:FileImportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GoogleSheetViewModel}">
            <views:GoogleSheetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SaleworkViewModel}">
            <views:SaleworkView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityLogViewModel}">
            <views:ActivityLogView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HelpViewModel}">
            <views:HelpView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
            <views:PlaceholderPageView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar: mặc định thu gọn thành cột biểu tượng (60px); rê chuột vào thì mở rộng đè lên nội dung, rời chuột thì thu lại. -->
        <Border x:Name="SidebarShell" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Panel.ZIndex="60"
                Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0"
                MouseEnter="Sidebar_MouseEnter" MouseLeave="Sidebar_MouseLeave">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="60" />
                    <Setter Property="Effect" Value="{x:Null}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.35" Color="#000000" />
                                </Setter.Value>
                            </Setter>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="244" Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="60" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel LastChildFill="True" ClipToBounds="True">
                <!-- Brand Header -->
                <Border DockPanel.Dock="Top" Padding="13,16,13,12" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentOrangeBrush}" Margin="0,0,10,0">
                            <TextBlock Text="📦" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Quản Lý Hàng Hoàn" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold" />
                            <TextBlock Text="Phiên bản v2 • Native WPF" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Theme Toggle + Compact KPI Summary at Bottom of Sidebar -->
                <Border DockPanel.Dock="Bottom" Padding="10,10,10,12" BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,1,0,0"
                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Button Content="{Binding ThemeToggleText}"
                                Command="{Binding ToggleThemeCommand}"
                                Style="{StaticResource SidebarThemeToggleStyle}"
                                Margin="3,0,3,10"
                                ToolTip="Chuyển giao diện Sáng / Tối ngay lập tức" />

                        <TextBlock Text="TỔNG QUAN NHANH" Foreground="{DynamicResource SidebarSectionBrush}" FontSize="10" FontWeight="Bold" Margin="4,0,0,6" />
                        <UniformGrid Columns="2" Rows="2">
                            <Border Background="{DynamicResource SidebarCardBgBrush}" CornerRadius="8" Padding="8,6" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="⏳ Đang chờ" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding SidebarPendingCount, StringFormat='{}{0:N0}'}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SidebarCardBgBrush}" CornerRadius="8" Padding="8,6" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="✅ Đã nhận" Foreground="{DynamicResource SidebarMutedBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding SidebarReceivedCount, StringFormat='{}{0:N0}'}" Foreground="#4ADE80" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SidebarCardBgBrush}" CornerRadius="8" Padding="8,6" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="🚨 Đỏ (&gt;24h)" Foreground="#FCA5A5" FontSize="10" />
                                    <TextBlock Text="{Binding SidebarRedCount, StringFormat='{}{0:N0}'}" Foreground="#F87171" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SidebarCardBgBrush}" CornerRadius="8" Padding="8,6" Margin="3">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Vàng (&gt;12h)" Foreground="#FCD34D" FontSize="10" />
                                    <TextBlock Text="{Binding SidebarYellowCount, StringFormat='{}{0:N0}'}" Foreground="#FBBF24" FontSize="16" FontWeight="Bold" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Scrollable Sidebar Navigation List -->
                <ScrollViewer Padding="0,8">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarExpanded}" Value="True">
                                    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <ItemsControl ItemsSource="{Binding NavigationItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Button Command="{Binding DataContext.ToggleNavGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Section}"
                                            ToolTip="Bấm để thu gọn / mở rộng nhóm">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarGroupHeaderButtonStyle}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding ShowSectionHeader}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right"
                                                    Background="{DynamicResource SidebarBadgeBgBrush}"
                                                    CornerRadius="8"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding ShowCollapsedGroupBadge, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding GroupBadge}"
                                                           Foreground="{DynamicResource SidebarBadgeFgBrush}"
                                                           FontSize="10"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding GroupChevron}" Width="14" FontSize="10" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Section}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>

                                    <Button Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.SelectNavigationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding Title}"
                                            AutomationProperties.Name="{Binding Title}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButtonStyle}">
                                                <Style.Triggers>
                                                    <!-- Cột thu gọn: biểu tượng căn giữa, không đệm hai bên -->
                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                                        <Setter Property="Padding" Value="0,9" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <DockPanel LastChildFill="True">
                                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                                <Border Background="{DynamicResource SidebarBadgeBgBrush}"
                                                        CornerRadius="10"
                                                        Padding="7,1"
                                                        Visibility="{Binding Badge, Converter={StaticResource StringNotEmptyToVis}}">
                                                    <TextBlock Text="{Binding Badge}" Foreground="{DynamicResource SidebarBadgeFgBrush}" FontSize="10.5" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" Width="24" FontSize="14" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding DataContext.IsSidebarExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Main Content Area + Top Global Search Bar + Floating Toast -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Global Search Bar (T020) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushLight}"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{DynamicResource SearchBoxBgBrush}"
                            BorderBrush="{DynamicResource SearchBoxBorderBrush}"
                            BorderThickness="1.2"
                            CornerRadius="8"
                            Padding="10,0"
                            Height="34">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔎" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13.5" />
                            <TextBox x:Name="GlobalSearchBox"
                                     Grid.Column="1"
                                     Text="{Binding GlobalSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     PreviewKeyDown="GlobalSearchBox_PreviewKeyDown"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     FontSize="12.5"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource InkPrimaryBrush}"
                                     CaretBrush="{DynamicResource InkPrimaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="Tìm toàn cục theo mã vận đơn, mã đơn, mã hoàn, mã phụ, tên sản phẩm, ghi chú... (Ctrl+K)"
                                       Foreground="{DynamicResource SearchBoxPlaceholderBrush}"
                                       Opacity="0.75"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GlobalSearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding GlobalSearchStatusText}"
                                       Foreground="{DynamicResource InkMutedBrush}"
                                       FontSize="11.5"
                                       VerticalAlignment="Center"
                                       Margin="8,0,6,0"
                                       Visibility="{Binding GlobalSearchStatusText, Converter={StaticResource StringNotEmptyToVis}}" />
                            <Button Grid.Column="3"
                                    Content="✕"
                                    Command="{Binding ClearGlobalSearchCommand}"
                                    Visibility="{Binding GlobalSearchText, Converter={StaticResource StringNotEmptyToVis}}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="{DynamicResource AlertRedTextBrush}"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Padding="6,2"
                                    ToolTip="Xóa tìm kiếm (Esc)" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource NeutralBadgeBgBrush}"
                            BorderBrush="{DynamicResource NeutralBadgeBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+K"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource NeutralBadgeFgBrush}" />
                    </Border>

                    <Button x:Name="NotificationBellButton" Grid.Column="2" Margin="10,0,0,0" Padding="8,0" Height="34" Cursor="Hand"
                            Command="{Binding NotificationsVm.ToggleCommand}"
                            Background="{DynamicResource NeutralBadgeBgBrush}" BorderBrush="{DynamicResource NeutralBadgeBorderBrush}" BorderThickness="1"
                            ToolTip="Thông báo (Ctrl+Shift+N)" AutomationProperties.Name="Thông báo">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="15" VerticalAlignment="Center" />
                            <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="9" VerticalAlignment="Center"
                                    Background="{DynamicResource AlertRedStrongTextBrush}"
                                    Visibility="{Binding NotificationsVm.HasUnread, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding NotificationsVm.UnreadText}" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding CurrentPage}" />

            <!-- Chuông thông báo: khung thả xuống (T027) -->
            <Border x:Name="NotificationDropdown" Grid.Row="1" Panel.ZIndex="110" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,4,16,0" Width="430" MaxHeight="520"
                    Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1.2" CornerRadius="10"
                    Visibility="{Binding NotificationsVm.IsOpen, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="14,10,10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔔 Thông báo" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Button Grid.Column="1" Content="Đánh dấu đã đọc" Command="{Binding NotificationsVm.MarkAllReadCommand}" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" />
                        <Button Grid.Column="2" Content="Xóa tất cả" Command="{Binding NotificationsVm.ClearAllCommand}" Padding="8,3" Cursor="Hand"
                                ToolTip="Chỉ xóa danh sách thông báo, không đụng dữ liệu đơn" />
                    </Grid>
                    <TextBlock Grid.Row="1" Text="Chưa có thông báo nào." HorizontalAlignment="Center" Margin="0,20,0,28"
                               Foreground="{DynamicResource InkMutedBrush}"
                               Visibility="{Binding NotificationsVm.IsEmpty, Converter={StaticResource BoolToVis}}" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding NotificationsVm.Items}" BorderThickness="0,1,0,0" Background="Transparent"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.NotificationsVm.OpenItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="14,8" Cursor="Hand" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource BorderBrushLight}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceMutedBgBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBgBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="11" Height="11" CornerRadius="6" Margin="2,4,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                ToolTip="{Binding LevelKey}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource InkMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LevelKey}" Value="Red">
                                                            <Setter Property="Background" Value="{DynamicResource AlertRedStrongTextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelKey}" Value="Yellow">
                                                            <Setter Property="Background" Value="{DynamicResource AlertYellowBorderStrongBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding LevelKey}" Value="Success">
                                                            <Setter Property="Background" Value="{DynamicResource AlertGreenBorderStrongBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimaryBrush}" />
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Top" Foreground="{DynamicResource InkMutedBrush}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Global Search Results Dropdown Overlay (T020) -->
            <Border x:Name="GlobalSearchDropdown"
                    Grid.Row="1"
                    Panel.ZIndex="100"
                    VerticalAlignment="Top"
                    Margin="16,4,16,0"
                    MaxHeight="460"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushStrong}"
                    BorderThickness="1.2"
                    CornerRadius="10"
                    Visibility="{Binding IsGlobalSearchOpen, Converter={StaticResource BoolToVis}}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.22" Color="#000000" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="GlobalSearchResultsList"
                             Grid.Row="0"
                             ItemsSource="{Binding GlobalSearchResults}"
                             SelectedItem="{Binding SelectedGlobalSearchResult, Mode=TwoWay}"
                             MouseDoubleClick="GlobalSearchResultsList_MouseDoubleClick"
                             PreviewKeyDown="GlobalSearchResultsList_PreviewKeyDown"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MaxHeight="400">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DataGridSelectedBgBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource DataGridSelectedFgBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel LastChildFill="True">
                                    <Button DockPanel.Dock="Right"
                                            Content="Đi tới bảng"
                                            Command="{Binding DataContext.GoToGlobalSearchTableCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource FilterPillButtonStyle}"
                                            Padding="8,3"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            ToolTip="Chuyển tới bảng chứa kiện này và chọn dòng" />

                                    <Border DockPanel.Dock="Right"
                                            Background="{DynamicResource SurfaceSubtleBgBrush}"
                                            BorderBrush="{DynamicResource BorderBrushStrong}"
                                            BorderThickness="1"
                                            CornerRadius="5"
                                            Padding="7,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LocationLabel}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource InkSecondaryBrush}" />
                                    </Border>

                                    <Border DockPanel.Dock="Right"
                                            Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                            CornerRadius="5"
                                            Padding="7,2"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=Foreground}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{Binding Platform, Converter={StaticResource PlatformBrushConverter}}"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Platform}"
                                                           Foreground="{Binding Platform, Converter={StaticResource PlatformBrushConverter}, ConverterParameter=Foreground}"
                                                           FontSize="10.5"
                                                           FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding OrderId}"
                                                       FontFamily="Consolas"
                                                       FontWeight="Bold"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource InkPrimaryBrush}"
                                                       Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding DisplayTracking}"
                                                       FontFamily="Consolas"
                                                       FontWeight="SemiBold"
                                                       FontSize="12.5"
                                                       Foreground="{DynamicResource AlertGreenTextBrush}"
                                                       Margin="0,0,8,0" />
                                            <Border Background="{DynamicResource AlertGreenBadgeBgBrush}"
                                                    BorderBrush="{DynamicResource AlertGreenBorderStrongBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,1"
                                                    Visibility="{Binding IsExactCodeMatch, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Khớp mã"
                                                           FontSize="10.5"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AlertGreenTextBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding ItemsSummary}"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty search result message -->
                    <Border Grid.Row="0"
                            Padding="18,16"
                            Visibility="{Binding HasGlobalSearchNoResults, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Không tìm thấy kiện hàng nào khớp từ khóa."
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <!-- Overflow footer -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource SurfaceMutedBgBrush}"
                            BorderBrush="{DynamicResource BorderBrushLight}"
                            BorderThickness="0,1,0,0"
                            Padding="12,7"
                            CornerRadius="0,0,10,10"
                            Visibility="{Binding HasGlobalSearchOverflow, Converter={StaticResource BoolToVis}}">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Đóng (Esc)"
                                    Command="{Binding CloseGlobalSearchDropdownCommand}"
                                    Style="{StaticResource FilterPillButtonStyle}"
                                    Padding="8,2"
                                    Margin="0" />
                            <TextBlock Text="{Binding GlobalSearchOverflowMessage}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AlertYellowTextBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Panel.ZIndex="110"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,22,48"
                    Padding="14,10"
                    CornerRadius="10"
                    BorderThickness="1"
                    Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#0F172A" />
                        <Setter Property="BorderBrush" Value="#334155" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="Background" Value="#7F1D1D" />
                                <Setter Property="BorderBrush" Value="#EF4444" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ToastIsWarning}" Value="True">
                                <Setter Property="Background" Value="#78350F" />
                                <Setter Property="BorderBrush" Value="#F59E0B" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ToastMessage}"
                               Foreground="#F8FAFC"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               MaxWidth="440"
                               TextWrapping="Wrap"
                               Margin="0,0,10,0" />
                    <Button Content="↩ Hoàn tác"
                            Command="{Binding UndoDeleteCommand}"
                            Visibility="{Binding CanUndoDelete, Converter={StaticResource BoolToVis}}"
                            Background="#F97316"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            Padding="10,4"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Margin="0,0,8,0" />
                    <Button Content="✕"
                            Command="{Binding DismissToastCommand}"
                            Background="Transparent"
                            Foreground="#CBD5E1"
                            BorderThickness="0"
                            Padding="4,2"
                            FontSize="12"
                            FontWeight="Bold"
                            Cursor="Hand"
                            ToolTip="Đóng thông báo" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
