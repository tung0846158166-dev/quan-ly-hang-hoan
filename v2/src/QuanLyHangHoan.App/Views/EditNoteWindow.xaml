<Window x:Class="QuanLyHangHoan.App.Views.EditNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chỉnh sửa nội dung"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="12"
            Padding="18">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource InkPrimaryBrush}" />
            <TextBlock x:Name="SubtitleText"
                       FontSize="12"
                       Foreground="{DynamicResource InkMutedBrush}"
                       Margin="0,3,0,12" />
            <TextBlock x:Name="FieldLabelText"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource InkSecondaryBrush}"
                       Margin="0,0,0,6" />
            <TextBox x:Name="NoteInput"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     MinHeight="110"
                     MaxHeight="220"
                     Padding="10,8"
                     FontSize="13"
                     Background="{DynamicResource InputBgBrush}"
                     Foreground="{DynamicResource InkPrimaryBrush}"
                     BorderBrush="{DynamicResource InputBorderBrush}"
                     BorderThickness="1"
                     Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy"
                        Click="CancelButton_Click"
                        Style="{StaticResource FilterPillButtonStyle}"
                        MinWidth="82"
                        Margin="0,0,8,0" />
                <Button Content="Lưu thay đổi"
                        Click="SaveButton_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Background="#2563EB"
                        MinWidth="110" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
