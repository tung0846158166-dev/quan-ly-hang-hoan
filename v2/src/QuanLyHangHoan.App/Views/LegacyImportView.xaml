<UserControl x:Class="QuanLyHangHoan.App.Views.LegacyImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:LegacyImportViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="↺ Làm mới"
                        Command="{Binding ResetCommand}"
                        Style="{StaticResource FilterPillButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="0" />
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📂 Nhập dữ liệu từ app cũ (v1.x → v2)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Border Background="{DynamicResource DemoBadgeBgBrush}" BorderBrush="{DynamicResource DemoBadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GIẢ LẬP — KHÔNG ĐỌC Ổ ĐĨA" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DemoBadgeFgBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Luồng an toàn bắt buộc: Chọn thư mục nguồn → Chạy thử (Dry-run) xem báo cáo đối chiếu → Tick xác nhận → Nhập thật."
                               FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left">

                <!-- Step 1: Select source folder & Dry-run -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="BƯỚC 1 — CHỌN THƯ MỤC NGUỒN &amp; CHẠY THỬ (DRY-RUN)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Thư mục chứa du_lieu_hang_hoan.json, các file phu_*.json và thư mục photos/. Hệ thống sẽ sao chép sang thư mục riêng, kiểm SHA256 và đối chiếu trước khi ghi SQLite."
                                   FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" CornerRadius="7" Padding="10,0" Height="36" Margin="0,0,10,0">
                                <Grid>
                                    <TextBox Text="{Binding SourceFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             VerticalContentAlignment="Center"
                                             FontFamily="Consolas"
                                             FontSize="12.5"
                                             Foreground="{DynamicResource InkPrimaryBrush}" />
                                    <TextBlock Text="Ví dụ: C:\Demo\QuanLyHangHoan (hoặc bấm Chọn thư mục...)"
                                               Foreground="{DynamicResource InkSubtleBrush}"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SourceFolderPath}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <Button Grid.Column="1"
                                    Content="📁 Chọn thư mục..."
                                    Command="{Binding BrowseFolderCommand}"
                                    Style="{StaticResource FilterPillButtonStyle}"
                                    Height="36"
                                    Padding="14,0"
                                    Margin="0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🧪 Chạy thử (Dry-run)"
                                    Command="{Binding RunDryRunCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Background="#2563EB"
                                    Padding="16,9"
                                    FontSize="13" />
                            <TextBlock Text="Đang xử lý..."
                                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBlueBrush}" />
                        </StackPanel>

                        <Border Background="{DynamicResource AlertRedCardBgBrush}" BorderBrush="{DynamicResource AlertRedCardBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,10,0,0"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource AlertRedTextBrush}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Step 2: Dry-run Report -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14"
                        Visibility="{Binding HasCompletedDryRun, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border DockPanel.Dock="Right" Background="{DynamicResource AlertGreenBadgeBgBrush}" CornerRadius="10" Padding="10,3">
                                <TextBlock Text="✓ Đã chạy thử xong" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AlertGreenTextBrush}" />
                            </Border>
                            <TextBlock Text="BƯỚC 2 — BÁO CÁO CHẠY THỬ (DRY-RUN)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" VerticalAlignment="Center" />
                        </DockPanel>

                        <UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="🚚 Đơn chính" FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" />
                                    <TextBlock Text="{Binding DryRunReport.MainOrdersCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,8">
                                <StackPanel>
                                    <TextBlock Text="📦 Kho lưu trữ (đã dời)" FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" />
                                    <TextBlock Text="{Binding DryRunReport.ArchivedOrdersCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AlertGreenTextBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="🗑️ Đơn đã xóa" FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" />
                                    <TextBlock Text="{Binding DryRunReport.DeletedOrdersCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource InkSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="📷 Ảnh nhúng (Base64)" FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" />
                                    <TextBlock Text="{Binding DryRunReport.EmbeddedPhotosCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBlueBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource InfoBlueCardBgBrush}" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="🏷️ Chuẩn hóa sàn → TikTok" FontSize="11.5" Foreground="{DynamicResource SafeBadgeFgBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DryRunReport.NormalizedPlatformCount, StringFormat='{}{0:N0}'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SafeBadgeFgBrush}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource AlertYellowCardBgBrush}" BorderBrush="{DynamicResource AlertYellowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Trùng khóa / Cảnh báo" FontSize="11.5" Foreground="{DynamicResource AlertYellowDarkTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DryRunReport.DuplicateGroupsCount, StringFormat='{}{0:N0} nhóm'}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AlertYellowStrongTextBrush}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Skipped by decision -->
                        <Border Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding HasSkippedByDecision, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Bỏ theo quyết định của chủ dự án:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkTertiaryBrush}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding DryRunReport.SkippedByDecision}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Warnings list -->
                        <Border Background="{DynamicResource AlertYellowCardBgBrush}" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8"
                                Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Chi tiết cảnh báo từ chạy thử:" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AlertYellowDarkTextBrush}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding DryRunReport.Warnings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource AlertYellowDarkTextBrush}" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding DryRunReport.SummaryNote}" FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Step 3: Confirmation & Execute Real Import -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="BƯỚC 3 — XÁC NHẬN &amp; NHẬP THẬT" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Nút Nhập thật chỉ được bật SAU KHI chạy thử (dry-run) hoàn tất cho đường dẫn hiện tại và bạn đánh dấu xác nhận bên dưới."
                                   FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <CheckBox Content="Tôi đã xem kỹ báo cáo chạy thử và xác nhận thực hiện nhập dữ liệu vào bản v2."
                                  IsChecked="{Binding IsConfirmed, Mode=TwoWay}"
                                  IsEnabled="{Binding HasCompletedDryRun}"
                                  FontSize="12.5"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource InkPrimaryBrush}"
                                  Margin="0,0,0,14" />

                        <Button Content="📥 Nhập thật vào v2"
                                Command="{Binding ExecuteImportCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Background="#DC2626"
                                Padding="18,10"
                                FontSize="13"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>

                <!-- Result Banner -->
                <Border Background="{DynamicResource AlertGreenCardBgBrush}" BorderBrush="{DynamicResource AlertGreenCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14"
                        Visibility="{Binding HasImportResult, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="✅ KẾT QUẢ NHẬP DỮ LIỆU" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource AlertGreenTextBrush}" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ImportResult.Message}" FontSize="12.5" Foreground="{DynamicResource AlertGreenStrongTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource AlertGreenStrongTextBrush}" TextWrapping="Wrap">
                            <Run Text="Đã nhập: " FontWeight="Bold" />
                            <Run Text="{Binding ImportResult.ImportedMainOrders, StringFormat='{}{0:N0} đơn chính', Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding ImportResult.ImportedArchivedOrders, StringFormat='{}{0:N0} lưu trữ', Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding ImportResult.ImportedDeletedOrders, StringFormat='{}{0:N0} đã xóa', Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding ImportResult.ImportedPhotos, StringFormat='{}{0:N0} ảnh', Mode=OneWay}" />
                            <Run Text=" • " />
                            <Run Text="{Binding ImportResult.NormalizedPlatformCount, StringFormat='{}chuẩn hóa TikTok: {0:N0}', Mode=OneWay}" />
                            <Run Text=" (bỏ qua trùng: " />
                            <Run Text="{Binding ImportResult.SkippedDuplicates, StringFormat='{}{0:N0}', Mode=OneWay}" />
                            <Run Text=")" />
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#0F172A" Padding="18,9">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</UserControl>
