<UserControl x:Class="QuanLyHangHoan.App.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AiChatViewModel}"
             UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource CardBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề cửa sổ chat -->
        <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClosePanelCommand}" Width="28" Height="28" Padding="0"
                        ToolTip="Đóng" Cursor="Hand" />
                <Button DockPanel.Dock="Right" Content="Mới" Command="{Binding NewChatCommand}" Padding="10,3" Margin="0,0,8,0"
                        ToolTip="Bắt đầu cuộc trò chuyện mới" Cursor="Hand" />
                <StackPanel>
                    <TextBlock Text="✨ Hỏi AI về đơn hàng" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                    <TextBlock Text="Chỉ ĐỌC dữ liệu. Tên, SĐT, địa chỉ người nhận được ẩn."
                               FontSize="11" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Chưa có khóa API: nhắc và mở Cài đặt -->
        <Border Grid.Row="1" Margin="12,10,12,0" Padding="12,10" CornerRadius="8" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1"
                Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Chưa có khóa API. Hãy nhập khóa Groq và/hoặc Google trong Cài đặt." TextWrapping="Wrap" FontSize="12.5" Foreground="#78350F" />
                <Button Content="Mở Cài đặt trợ lý AI" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0" Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- Hội thoại -->
        <ScrollViewer Grid.Row="2" x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="12,0,12,0">
            <StackPanel>
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                    <TextBlock Text="Gợi ý câu hỏi:" FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" HorizontalAlignment="Left" Padding="10,5" Margin="0,0,0,6" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,6" Padding="12,9" CornerRadius="10" MaxWidth="400">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="Background" Value="{DynamicResource SurfaceMutedBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Background" Value="#DBEAFE" />
                                                <Setter Property="BorderBrush" Value="#93C5FD" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                             TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource InkPrimaryBrush}" />
                                    <TextBlock Text="{Binding RefsHeader}" FontSize="11.5" FontWeight="SemiBold" Margin="0,8,0,4"
                                               Foreground="{DynamicResource InkSecondaryBrush}"
                                               Visibility="{Binding HasRefs, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Refs}" MaxHeight="200"
                                                  Visibility="{Binding HasRefs, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.OpenRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" HorizontalContentAlignment="Left" Padding="8,3" Margin="0,0,0,3" Cursor="Hand">
                                                    <TextBlock FontFamily="Consolas" FontSize="11.5">
                                                        <Run Text="{Binding OrderId, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Track, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                                    </TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Expander Header="Xem cách tính" FontSize="11.5" Margin="0,6,0,0"
                                              Visibility="{Binding HasTrace, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Trace}" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource InkMutedBrush}" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Trạng thái -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="14,6,14,4" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" MaxHeight="90" />

        <!-- Ô nhập -->
        <Grid Grid.Row="4" Margin="12,0,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13.5"
                     AcceptsReturn="False" VerticalContentAlignment="Center" IsEnabled="{Binding Available}" KeyDown="InputBox_KeyDown" />
            <Button Grid.Column="1" Content="Gửi" Command="{Binding SendCommand}" Padding="18,8" Margin="8,0,0,0" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</UserControl>
