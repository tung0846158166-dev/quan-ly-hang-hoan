<Window x:Class="QuanLyHangHoan.App.Views.OffPlatformOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo đơn ngoài sàn"
        Width="860" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="🏪 Tạo đơn ngoài sàn" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
            <TextBlock FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                       Text="Đơn bán qua Facebook, Zalo, tại shop... Tìm sản phẩm đã có để thêm nhanh; để trống mã thì tự sinh mã NS... (ghi lên kiện để quét nhận). Không ghi thông tin người mua." />
        </StackPanel>

        <!-- Mã + kênh + loại đơn -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Mã vận đơn (không bắt buộc)" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="CodeBox" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" FontFamily="Consolas"
                         ToolTip="Để trống: tự sinh mã NS + ngày + 4 ký tự" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Mã đơn hàng (không bắt buộc)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding OrderId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" FontFamily="Consolas"
                         ToolTip="Mã đơn trên Salework / hệ thống bán hàng. Để trống: dùng mã vận đơn" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Kênh bán" Style="{StaticResource FieldLabel}" />
                <ComboBox IsEditable="True" Text="{Binding Channel, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Channels}" Padding="8,6" FontSize="13" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="Loại đơn" Style="{StaticResource FieldLabel}" />
                <ComboBox SelectedItem="{Binding OrderType}" ItemsSource="{Binding OrderTypes}" Padding="8,6" FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- Tìm sản phẩm -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="🔎 Thêm sản phẩm" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
            <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}"
                     PreviewKeyDown="SearchBox_PreviewKeyDown" AutomationProperties.Name="Tìm sản phẩm" />
            <TextBlock Text="{Binding CatalogHint}" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Margin="2,3,0,0" />
            <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="6" Margin="0,4,0,0" MaxHeight="190"
                    Visibility="{Binding HasSuggestions, Converter={StaticResource B2V}}" Background="{DynamicResource CardBgBrush}">
                <ListBox x:Name="SuggestionList" ItemsSource="{Binding Suggestions}" BorderThickness="0" Background="Transparent"
                         MouseDoubleClick="SuggestionList_Activate" PreviewKeyDown="SuggestionList_PreviewKeyDown" PreviewMouseLeftButtonUp="SuggestionList_Activate">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,1">
                                <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Margin="12,0,0,0">
                                    <Run Text="{Binding Units, StringFormat='{}{0:N0} cái đã có'}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource InkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <StackPanel Visibility="{Binding HasQuickProducts, Converter={StaticResource B2V}}" Margin="0,8,0,0">
                <TextBlock Text="Hay dùng (bấm để thêm):" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding QuickProducts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ChipButton}" Content="{Binding Name}" MaxWidth="260" ToolTip="{Binding Name}"
                                    Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- Danh sách sản phẩm của đơn -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="+ Thêm dòng trống" Command="{Binding AddEmptyRowCommand}" Padding="10,3" FontSize="12" />
                <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}">
                    <Run Text="Sản phẩm trong đơn — " /><Run Text="{Binding ItemsSummary, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="4,0,34,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Tên sản phẩm" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" />
                <TextBlock Grid.Column="1" Text="Màu" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Margin="6,0,0,0" />
                <TextBlock Grid.Column="2" Text="Size" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Margin="6,0,0,0" />
                <TextBlock Grid.Column="3" Text="Số lượng" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" Margin="6,0,0,0" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="34" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Product, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" FontSize="13" AutomationProperties.Name="Tên sản phẩm" />
                                <ComboBox Grid.Column="1" IsEditable="True" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding ColorOptions}"
                                          Margin="6,0,0,0" Padding="6,5" FontSize="13" ToolTip="Màu đã gặp của sản phẩm này (gõ màu khác cũng được)" />
                                <ComboBox Grid.Column="2" IsEditable="True" Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding SizeOptions}"
                                          Margin="6,0,0,0" Padding="6,5" FontSize="13" ToolTip="Size đã gặp của sản phẩm này (gõ size khác cũng được)" />
                                <DockPanel Grid.Column="3" Margin="6,0,0,0">
                                    <Button DockPanel.Dock="Left" Content="−" Width="26" Command="{Binding DecreaseCommand}" ToolTip="Bớt 1" />
                                    <Button DockPanel.Dock="Right" Content="+" Width="26" Command="{Binding IncreaseCommand}" ToolTip="Thêm 1" />
                                    <TextBox Text="{Binding QtyText, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Padding="2,5" FontSize="13" Margin="2,0" />
                                </DockPanel>
                                <Button Grid.Column="4" Content="✕" Margin="6,0,0,0" ToolTip="Bỏ dòng này"
                                        Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Giá trị + ghi chú -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}">
                    <Run Text="Giá trị đơn " /><Run Text="{Binding PricePreview, Mode=OneWay}" Foreground="{DynamicResource AlertGreenTextBrush}" />
                </TextBlock>
                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" ToolTip="Ví dụ: 350000, 350.000, 350k, 1,2tr" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Ghi chú / lý do hoàn (không ghi tên, số điện thoại khách)" Style="{StaticResource FieldLabel}" />
                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FieldBox}" />
            </StackPanel>
        </Grid>

        <!-- Thông báo + nút -->
        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Đóng (Esc)" Padding="16,7" Margin="0,0,10,0" IsCancel="True" Click="Close_Click" />
                <Button Content="Tạo &amp; nhập đơn tiếp (Ctrl+Shift+Enter)" Padding="14,7" Margin="0,0,10,0" Click="CreateAnother_Click" />
                <Button Content="Tạo đơn (Ctrl+Enter)" Padding="16,7" FontWeight="Bold" Click="Create_Click" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource AlertRedTextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource B2V}}" />
                <TextBlock Text="{Binding LastCreatedText}" Foreground="{DynamicResource AlertGreenTextBrush}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                           Visibility="{Binding HasLastCreated, Converter={StaticResource B2V}}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
