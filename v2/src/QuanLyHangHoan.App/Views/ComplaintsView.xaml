<UserControl x:Class="QuanLyHangHoan.App.Views.ComplaintsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ComplaintsViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">
    <!-- Bảng Khiếu nại (chủ dự án 26/11/2026): đơn bấm "Khiếu nại" ở bảng đơn; chọn trạng thái từng đơn, lọc theo trạng thái. -->
    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
                <TextBlock Text="⚖️ Khiếu nại" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                <TextBlock Text="Đơn đã bấm &quot;Khiếu nại&quot; ở bảng đơn. Chọn trạng thái ở cột Khiếu nại; chuột phải để ghi chú / bỏ khiếu nại; nhấp đúp để xem chi tiết."
                           FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,9">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="processing">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterProcessing}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding ProcessingCount, StringFormat='⏳ Đang khiếu nại ({0:N0})'}" />
                    </Button>
                    <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="success">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterSuccess}" Value="True">
                                        <Setter Property="Background" Value="#16A34A" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#16A34A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding SuccessCount, StringFormat='✅ Thành công ({0:N0})'}" />
                    </Button>
                    <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="failed">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterFailed}" Value="True">
                                        <Setter Property="Background" Value="#DC2626" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#DC2626" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding FailedCount, StringFormat='❌ Thất bại ({0:N0})'}" />
                    </Button>
                    <Button Command="{Binding SetStatusFilterCommand}" CommandParameter="all">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding TotalCount, StringFormat='🌐 Tất cả ({0:N0})'}" />
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="280" Padding="8,5"
                             ToolTip="Tìm theo mã đơn, mã vận đơn, sản phẩm, ghi chú khiếu nại" />
                    <Button Content="✕" Command="{Binding ClearSearchCommand}" Margin="4,0,0,0" Padding="8,4" ToolTip="Xóa ô tìm" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14,10,14,10">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <DataGrid x:Name="ComplaintsGrid"
                          ItemsSource="{Binding VisibleRows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          MouseDoubleClick="ComplaintsGrid_MouseDoubleClick"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                          BorderThickness="0" Background="{DynamicResource CardBgBrush}" MinRowHeight="38"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" CellStyle="{StaticResource ModernDataGridCellStyle}">
                    <DataGrid.Resources>
                        <ContextMenu x:Key="ComplaintRowMenu">
                            <MenuItem Header="🔍 Xem chi tiết" FontWeight="SemiBold"
                                      Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="📝 Ghi chú khiếu nại..."
                                      Command="{Binding DataContext.EditNoteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                            <MenuItem Header="↩️ Bỏ khiếu nại"
                                      Command="{Binding DataContext.RemoveComplaintCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                        </ContextMenu>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu" Value="{StaticResource ComplaintRowMenu}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="50" />
                        <DataGridTemplateColumn Header="Khiếu nại" Width="140" SortMemberPath="ComplaintStatus">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.StatusChoices, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              SelectedItem="{Binding ComplaintStatus, Mode=OneWay}"
                                              IsEnabled="{Binding DataContext.CanWrite, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              DropDownClosed="StatusCombo_DropDownClosed"
                                              Margin="2,4" Padding="6,3" FontWeight="SemiBold" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ngày khiếu nại" Binding="{Binding ComplaintAt}" Width="140" />
                        <DataGridTextColumn Header="Ngày xong" Binding="{Binding ComplaintDoneAt}" Width="140" />
                        <DataGridTextColumn Header="Lưu trữ" Binding="{Binding AutoArchiveText}" Width="150" />
                        <DataGridTextColumn Header="Sàn" Binding="{Binding Platform}" Width="80" />
                        <DataGridTextColumn Header="Mã đơn hàng" Binding="{Binding OrderId}" Width="150" />
                        <DataGridTextColumn Header="Mã vận đơn" Binding="{Binding DisplayTracking}" Width="200" />
                        <DataGridTextColumn Header="Nhận tại kho" Binding="{Binding Status}" Width="110" />
                        <DataGridTextColumn Header="Trạng thái kiện" Binding="{Binding PlatformStatus}" Width="130" />
                        <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ItemsSummary}" Width="220" />
                        <DataGridTextColumn Header="Giá trị" Binding="{Binding PriceFormatted}" Width="100" />
                        <DataGridTextColumn Header="Ghi chú khiếu nại" Binding="{Binding ComplaintNote}" Width="*" MinWidth="200" />
                        <DataGridTextColumn Header="Nằm ở" Binding="{Binding Location}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <TextBlock Text="Không có đơn nào ở mục này. Bấm &quot;⚖️ Khiếu nại&quot; ở bảng đơn (chuột phải một dòng, hoặc chọn nhiều dòng) để thêm."
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <Border Grid.Row="3" Background="#0F172A" Padding="18,8">
            <TextBlock Text="{Binding StatusBarText}" Foreground="#CBD5E1" FontSize="11.5" />
        </Border>
    </Grid>
</UserControl>
