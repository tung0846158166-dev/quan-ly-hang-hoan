<Window ShowInTaskbar="False" x:Class="QuanLyHangHoan.App.Views.ConfirmActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xác nhận thao tác"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="12"
            Padding="18">
        <StackPanel>
            <TextBlock x:Name="TitleText"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource InkPrimaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="MessageText"
                       FontSize="13"
                       Foreground="{DynamicResource InkSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,10,0,16"
                       LineHeight="20" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy"
                        Click="CancelButton_Click"
                        Style="{StaticResource FilterPillButtonStyle}"
                        MinWidth="82"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton"
                        Content="Xác nhận"
                        Click="ConfirmButton_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Background="#DC2626"
                        MinWidth="110" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
