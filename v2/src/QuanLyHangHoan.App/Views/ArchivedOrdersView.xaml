<UserControl x:Class="QuanLyHangHoan.App.Views.ArchivedOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             xmlns:ctl="clr-namespace:QuanLyHangHoan.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ArchivedOrdersViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="↺ Xóa bộ lọc"
                        Command="{Binding ResetAllFiltersCommand}"
                        Style="{StaticResource FilterPillButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="0" />
                <Button DockPanel.Dock="Right"
                        Content="⬇ Xuất file ▾"
                        Click="ExportButton_Click"
                        Style="{StaticResource FilterPillButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        ToolTip="Xuất các dòng đang hiển thị ra Excel hoặc CSV (không có thông tin khách)">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Excel (.xlsx): các dòng đang hiển thị" Command="{Binding PlacementTarget.DataContext.ExportVisibleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="xlsx" />
                            <MenuItem Header="CSV (.csv): các dòng đang hiển thị" Command="{Binding PlacementTarget.DataContext.ExportVisibleCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="csv" />
                            <Separator />
                            <MenuItem Header="File xuất không chứa tên, SĐT, địa chỉ khách" IsEnabled="False" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button DockPanel.Dock="Right" Content="{Binding Filters.ButtonText}" Command="{Binding Filters.TogglePanelCommand}" Style="{StaticResource FilterPillButtonStyle}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Lọc theo sản phẩm và khoảng ngày" />
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦 Kho lưu trữ (24h)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Border Background="{DynamicResource AlertGreenCardBgBrush}" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DỮ LIỆU GIẢ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AlertGreenTextBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Lưu trữ các đơn đã nhận về kho từ 24 giờ trở lên để giữ bảng đơn chính luôn gọn nhẹ." FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
                <WrapPanel Margin="0,10,0,0" Visibility="{Binding Filters.ShowPanel, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Sản phẩm:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Filters.ProductFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="200" Height="30" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,14,0" ToolTip="Gõ một phần tên sản phẩm (không cần dấu)" />
                    <TextBlock Text="{Binding Filters.DateLabel, StringFormat='{}{0} từ:'}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding Filters.DateFrom}" Width="120" Height="30" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="đến:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding Filters.DateTo}" Width="120" Height="30" FontSize="12" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Search, Platform, Sort -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="all">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformAll}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding TotalCount, StringFormat='🌐 Cả 2 sàn ({0:N0})'}" />
                    </Button>
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="Shopee">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformShopee}" Value="True">
                                        <Setter Property="Background" Value="#EE4D2D" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#EE4D2D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding ShopeeCount, StringFormat='🟠 Shopee ({0:N0})'}" />
                    </Button>
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="TikTok" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformTikTok}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TikTokBadgeBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource TikTokBadgeBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding TikTokCount, StringFormat='⚫ TikTok ({0:N0})'}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sắp xếp:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Label"
                              Width="210"
                              Height="32"
                              VerticalContentAlignment="Center"
                              FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid + Empty State -->
        <Grid Grid.Row="2" Margin="14,10">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <DataGrid x:Name="ArchivedGrid"
                          ItemsSource="{Binding VisibleOrders}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          PreviewKeyDown="ArchivedGrid_PreviewKeyDown"
                          MouseDoubleClick="ArchivedGrid_MouseDoubleClick"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                          BorderThickness="0"
                          Background="{DynamicResource CardBgBrush}"
                          MinRowHeight="36"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          VirtualizingPanel.CacheLength="0,0"
                          ScrollViewer.CanContentScroll="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                          CellStyle="{StaticResource ModernDataGridCellStyle}">
                    <DataGrid.Resources>
                        <ContextMenu x:Key="ArchivedRowContextMenu">
                            <MenuItem Header="🔍 Xem chi tiết"
                                      FontWeight="SemiBold"
                                      Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="↩ Trả về bảng chính"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="{Binding DataContext.WriteDisabledTooltip, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      Command="{Binding DataContext.UnarchiveRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="📜 Xem lịch sử sửa"
                                      Command="{Binding DataContext.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="🗑️ Xóa... (Del)"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="{Binding DataContext.WriteDisabledTooltip, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource DataGridRowBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
                            <Setter Property="ContextMenu" Value="{StaticResource ArchivedRowContextMenu}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="56">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Ngày về kho" Binding="{Binding RecvDate}" Width="138" SortMemberPath="RecvDateParsed" />
                        <DataGridTemplateColumn Header="Sàn" Width="98" SortMemberPath="Platform">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Platform, Converter={StaticResource PlatformBrushConverter}}"
                                            CornerRadius="5" Padding="7,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Platform}"
                                                   Foreground="{Binding Platform, Converter={StaticResource PlatformBrushConverter}, ConverterParameter=Foreground}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mã đơn hàng" Binding="{Binding OrderId}" Width="145">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="12.5" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mã vận đơn" Binding="{Binding DisplayTracking}" Width="155">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Tên sản phẩm / Phân loại" Width="245" SortMemberPath="ItemsSummary">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ctl:ItemLinesTextBlock Lines="{Binding ItemLines}" Chip="{Binding PartialChip}" ToolTip="{Binding ItemsTooltip}" Margin="6,0" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="SL" Binding="{Binding TotalQty}" Width="48">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="ĐVVC" Binding="{Binding Carrier}" Width="110" />
                        <DataGridTextColumn Header="Giá trị" Binding="{Binding PriceFormatted}" Width="110" SortMemberPath="Price">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Visibility="Collapsed" Header="Ảnh" Width="86" SortMemberPath="HasPhoto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="📷 Xem"
                                                Command="{Binding DataContext.OpenPhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}"
                                                Background="{DynamicResource InfoBlueCardBgBrush}"
                                                Foreground="{DynamicResource InfoBlueTextBrush}"
                                                BorderBrush="{DynamicResource InfoBlueCardBorderBrush}"
                                                BorderThickness="1"
                                                Padding="8,2"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Cursor="Hand" />
                                        <TextBlock Text="—"
                                                   Foreground="{DynamicResource InkSubtleBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ghi chú" Binding="{Binding NoteDisplay}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding NoteDisplay}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Thao tác" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="•••"
                                            Click="RowActionButton_Click"
                                            Style="{StaticResource FilterPillButtonStyle}"
                                            Padding="8,2"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            ToolTip="Mở menu thao tác (hoặc chuột phải)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Empty State -->
            <Border Background="{DynamicResource SurfaceMutedBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="📦" FontSize="38" HorizontalAlignment="Center" />
                    <TextBlock Text="Không có đơn lưu trữ nào khớp bộ lọc" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,4" />
                    <TextBlock Text="Thử xóa từ khóa hoặc chuyển sang Cả 2 sàn." FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <Button Content="✕ Xóa bộ lọc" Command="{Binding ResetAllFiltersCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Background="#EE4D2D" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#0F172A" Padding="18,8">
            <DockPanel><ctl:PagerBar DockPanel.Dock="Right" DataContext="{Binding Pager}" Margin="18,0,0,0" />
            <TextBlock Text="{Binding StatusBarText}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" /></DockPanel>
        </Border>
    </Grid>
</UserControl>
