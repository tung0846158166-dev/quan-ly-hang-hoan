<UserControl x:Class="QuanLyHangHoan.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StatisticsViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📥 Xuất CSV"
                            Command="{Binding ExportCsvCommand}"
                            Style="{StaticResource FilterPillButtonStyle}"
                            Margin="0,0,8,0" />
                    <Button Content="🔄 Tính lại số liệu"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Background="#2563EB"
                            VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📊 Thống kê đơn &amp; sản phẩm" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Border Background="{DynamicResource InfoBlueBadgeBgBrush}" BorderBrush="{DynamicResource InfoBlueCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="TÍNH TỪ DỮ LIỆU GIẢ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource InfoBlueTextBrush}" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding AlertRuleNote}" FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding MissingPhotoText, StringFormat=' • {0}'}"
                                   Visibility="{Binding HasMissingPhotos, Converter={StaticResource BoolToVis}}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AlertYellowTextBrush}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Scope, Platform, OrderType & Date Filters -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Phạm vi:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,8,0" />
                    <Button Command="{Binding SetScopeFilterCommand}" CommandParameter="include_archive">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeIncludeArchive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="📦 Bảng chính + Lưu trữ" />
                    </Button>
                    <Button Command="{Binding SetScopeFilterCommand}" CommandParameter="main_only" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScopeMainOnly}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="🚚 Chỉ bảng chính" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                    <TextBlock Text="Sàn:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,8,0" />
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="all">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformAll}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="🌐 Tất cả" />
                    </Button>
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="Shopee">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformShopee}" Value="True">
                                        <Setter Property="Background" Value="#EE4D2D" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#EE4D2D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="🟠 Shopee" />
                    </Button>
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="TikTok" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformTikTok}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TikTokBadgeBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource TikTokBadgeBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="⚫ TikTok" />
                    </Button>
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="Ngoài sàn" Margin="6,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformOff}" Value="True">
                                        <Setter Property="Background" Value="#16A34A" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#16A34A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="🏪 Ngoài sàn" />
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,14,2">
                    <TextBlock Text="Loại đơn:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding OrderTypeOptions}"
                              SelectedItem="{Binding SelectedOrderType}"
                              Width="165"
                              Height="30"
                              VerticalContentAlignment="Center"
                              FontSize="12" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,2">
                    <TextBlock Text="Từ:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="118" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Đến:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="118" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                    <Button Content="↺ Xóa lọc" Command="{Binding ClearDateFiltersCommand}" Style="{StaticResource FilterPillButtonStyle}" Margin="0" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Scrollable Dashboard Body -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,14">
            <StackPanel>
                <!-- KPI Cards -->
                <TextBlock Text="TỔNG QUAN THEO BỘ LỌC" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="2,0,0,8" />
                <UniformGrid Columns="5" Margin="0,0,0,16">
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="📋 Tổng đơn" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" />
                            <TextBlock Text="{Binding TotalOrders, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="{Binding TotalValueFormatted, StringFormat='Giá trị: {0}'}" FontSize="11.5" Foreground="{DynamicResource AccentBlueBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AlertGreenCardBgBrush}" BorderBrush="{DynamicResource AlertGreenCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="🟢 Đã nhận tại kho" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AlertGreenTextBrush}" />
                            <TextBlock Text="{Binding ReceivedCount, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AlertGreenStrongTextBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Đã quét nhận / hoàn tất" FontSize="11" Foreground="{DynamicResource AlertGreenTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="⏳ Đang chờ về" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" />
                            <TextBlock Text="{Binding PendingCount, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Chưa xác nhận nhận kho" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AlertYellowCardBgBrush}" BorderBrush="{DynamicResource AlertYellowCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="⚠️ Báo Vàng (&gt;12h)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AlertYellowTextBrush}" />
                            <TextBlock Text="{Binding YellowAlertCount, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AlertYellowStrongTextBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Quá 12h từ lúc hàng về" FontSize="11" Foreground="{DynamicResource AlertYellowDarkTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AlertRedCardBgBrush}" BorderBrush="{DynamicResource AlertRedCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="🚨 Báo Đỏ (&gt;24h)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AlertRedTextBrush}" />
                            <TextBlock Text="{Binding RedAlertCount, StringFormat='{}{0:N0}'}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AlertRedStrongTextBrush}" Margin="0,4,0,2" />
                            <TextBlock Text="Cần ưu tiên xử lý ngay" FontSize="11" Foreground="{DynamicResource AlertRedDarkTextBrush}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Tra nhanh sản phẩm (chủ dự án 27/11/2026): gõ tên -> số cái về kho / bị hoàn hôm nay, tuần này, tháng này -->
                <TextBlock Text="🔎 TRA NHANH SẢN PHẨM" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="2,4,0,4" />
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Xóa" Command="{Binding ClearProductLookupCommand}" Padding="10,4" Margin="8,0,0,0" />
                            <TextBox Text="{Binding ProductLookupText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="8,6" FontSize="13"
                                     AutomationProperties.Name="Tra nhanh sản phẩm" ToolTip="Gõ tên sản phẩm (không dấu cũng được)" />
                        </DockPanel>
                        <TextBlock Text="{Binding ProductLookupHint}" FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" Margin="2,5,0,0" TextWrapping="Wrap" />
                        <StackPanel Visibility="{Binding HasProductLookupRows, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Sản phẩm" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="" />
                                <TextBlock Grid.Column="2" Text="Hôm nay" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="{Binding WeekLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="{Binding MonthLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Right" />
                                <TextBlock Grid.Column="5" Text="Tất cả" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource InkMutedBrush}" TextAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ProductLookupRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="90" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimaryBrush}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Orders, StringFormat='{}{0:N0} đơn có sản phẩm này'}" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="✅ Về kho (đã nhận)" FontSize="11.5" Foreground="{DynamicResource AlertGreenTextBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Received.Today, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource InkPrimaryBrush}" />
                                                <TextBlock Grid.Column="3" Text="{Binding Received.Week, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource InkPrimaryBrush}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Received.Month, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource InkPrimaryBrush}" />
                                                <TextBlock Grid.Column="5" Text="{Binding Received.Total, StringFormat='{}{0:N0}'}" FontSize="14" FontWeight="Bold" TextAlignment="Right" Foreground="{DynamicResource InkSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="1" Text="↩️ Bị hoàn (ngày hoàn)" FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Returned.Today, StringFormat='{}{0:N0}'}" FontSize="12.5" TextAlignment="Right" Foreground="{DynamicResource InkSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Returned.Week, StringFormat='{}{0:N0}'}" FontSize="12.5" TextAlignment="Right" Foreground="{DynamicResource InkSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding Returned.Month, StringFormat='{}{0:N0}'}" FontSize="12.5" TextAlignment="Right" Foreground="{DynamicResource InkSecondaryBrush}" />
                                                <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding Returned.Total, StringFormat='{}{0:N0}'}" FontSize="12.5" TextAlignment="Right" Foreground="{DynamicResource InkMutedBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Thống kê SẢN PHẨM bị hoàn (cùng bộ lọc ở trên) -->
                <DockPanel Margin="2,4,0,2">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Thống kê sản phẩm:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,8,0" />
                        <Button Command="{Binding SetProductModeCommand}" CommandParameter="returned" Content="↩️ Bị hoàn" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsProductReturned}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                        <Button Command="{Binding SetProductModeCommand}" CommandParameter="received" Content="✅ Đã nhận tại kho" Margin="0,0,6,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding IsProductReceived}" Value="True"><Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                    </StackPanel>
                    <TextBlock Text="{Binding ProductSectionTitle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding ProductSectionHint}" FontSize="11.5" Foreground="{DynamicResource InkMutedBrush}" Margin="2,0,0,2" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ProductSummaryText}" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}" Margin="2,0,0,8" TextWrapping="Wrap" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <!-- ảnh 29 (26/11/2026): bảng bám lên trên, không bị kéo giãn theo khung Màu/size bên phải -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top">
                        <DataGrid x:Name="ProductGrid"
                                  ItemsSource="{Binding ProductRows}"
                                  SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                                  BorderThickness="0"
                                  Background="{DynamicResource CardBgBrush}"
                                  RowHeight="40"
                                  MaxHeight="520"
                                  ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                                  CellStyle="{StaticResource ModernDataGridCellStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40" />
                                <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Name}" Width="*" MinWidth="230">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding Name}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Số cái" Binding="{Binding Units, StringFormat='{}{0:N0}'}" Width="64" />
                                <DataGridTemplateColumn Header="Tỷ trọng" Width="118" SortMemberPath="SharePercent">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" Margin="4,0">
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding SharePercent, Mode=OneWay}" Height="16" Foreground="{DynamicResource AccentOrangeBrush}" Background="{DynamicResource SurfaceMutedBgBrush}" BorderThickness="0" />
                                                <TextBlock Text="{Binding ShareText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource InkPrimaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Số đơn" Binding="{Binding Orders, StringFormat='{}{0:N0}'}" Width="64" />
                                <DataGridTextColumn Header="Premium / Thường" Binding="{Binding PremiumText}" Width="150" MinWidth="130" />
                                <DataGridTextColumn Header="Sàn" Binding="{Binding PlatformText}" Width="105" />
                                <DataGridTextColumn Header="Lý do hay gặp" Binding="{Binding TopReason}" Width="150">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="ToolTip" Value="{Binding TopReason}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- khung Màu/size cao tối đa bằng bảng sản phẩm, danh sách dài thì cuộn bên trong (không đẩy cả trang) -->
                    <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="14,12" VerticalAlignment="Top" MaxHeight="520">
                        <StackPanel>
                            <TextBlock Text="🎨 Màu / size" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                            <TextBlock Text="Chọn một sản phẩm ở bảng bên trái để xem màu và size nào bị hoàn nhiều." FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSelectedProduct}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding VariantTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,8" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="420" PanningMode="VerticalOnly">
                            <ItemsControl ItemsSource="{Binding VariantRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Variant}" FontSize="12.5" Foreground="{DynamicResource InkPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Units, StringFormat='{}{0:N0} cái'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding SharePercent, Mode=OneWay}" Height="5" Margin="0,3,0,0" Foreground="{DynamicResource AccentOrangeBrush}" Background="{DynamicResource SurfaceMutedBgBrush}" BorderThickness="0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Table 1: Breakdown by Platform -->
                <TextBlock Text="CHI TIẾT THEO SÀN TMĐT" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="2,0,0,8" />
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True" Margin="0,0,0,16">
                    <DataGrid ItemsSource="{Binding PlatformBreakdown}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                              BorderThickness="0"
                              Background="{DynamicResource CardBgBrush}"
                              RowHeight="36"
                              ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                              CellStyle="{StaticResource ModernDataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sàn TMĐT" Binding="{Binding Platform}" Width="160">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tổng đơn" Binding="{Binding Total}" Width="100" />
                            <DataGridTextColumn Header="Đã về kho" Binding="{Binding Received}" Width="100" />
                            <DataGridTextColumn Header="Đang chờ" Binding="{Binding Pending}" Width="100" />
                            <DataGridTextColumn Header="Mất / K.cần" Binding="{Binding Other}" Width="110" />
                            <DataGridTextColumn Header="Vàng (&gt;12h)" Binding="{Binding Yellow}" Width="105">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="#D97706" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Đỏ (&gt;24h)" Binding="{Binding Red}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Foreground" Value="#DC2626" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Tổng giá trị" Binding="{Binding TotalValueFormatted}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Table 2: Breakdown by OrderType & Status side-by-side -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="CƠ CẤU LOẠI ĐƠN THEO SÀN" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="2,0,0,8" />
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding OrderTypeBreakdown}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                                      BorderThickness="0"
                                      Background="{DynamicResource CardBgBrush}"
                                      RowHeight="34"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                                      CellStyle="{StaticResource ModernDataGridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sàn" Binding="{Binding Platform}" Width="85" />
                                    <DataGridTextColumn Header="Loại đơn" Binding="{Binding OrderType}" Width="*" />
                                    <DataGridTextColumn Header="Số đơn" Binding="{Binding Count}" Width="75" />
                                    <DataGridTextColumn Header="Tỷ lệ" Binding="{Binding PercentText}" Width="70" />
                                    <DataGridTextColumn Header="Giá trị" Binding="{Binding TotalValueFormatted}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PHÂN BỐ THEO TRẠNG THÁI XỬ LÝ" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="2,0,0,8" />
                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                            <DataGrid ItemsSource="{Binding StatusBreakdown}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                                      BorderThickness="0"
                                      Background="{DynamicResource CardBgBrush}"
                                      RowHeight="34"
                                      ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                                      CellStyle="{StaticResource ModernDataGridCellStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusLabel}" Width="*" />
                                    <DataGridTextColumn Header="Số đơn" Binding="{Binding Count}" Width="75" />
                                    <DataGridTextColumn Header="Tỷ lệ" Binding="{Binding PercentText}" Width="70" />
                                    <DataGridTextColumn Header="Giá trị" Binding="{Binding TotalValueFormatted}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#0F172A" Padding="18,8">
            <TextBlock Text="{Binding StatusBarText}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
