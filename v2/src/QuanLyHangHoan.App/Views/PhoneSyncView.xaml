<UserControl x:Class="QuanLyHangHoan.App.Views.PhoneSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PhoneSyncViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,5"
                            Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AlertRedBadgeBgBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AlertRedCardBorderBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AlertGreenBadgeBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AlertGreenCardBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ConnectionStatusText}"
                                   FontWeight="Bold"
                                   FontSize="12.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AlertRedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <Button Command="{Binding ToggleSyncCommand}"
                            Content="{Binding SyncToggleButtonText}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Background="#2563EB"
                            Height="34"
                            Padding="14,0" />
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📱 Đồng bộ điện thoại" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Border Background="{DynamicResource DemoBadgeBgBrush}" BorderBrush="{DynamicResource DemoBadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GIẢ LẬP (--demo)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DemoBadgeFgBrush}" />
                        </Border>
                        <Button Content="⚡ Phát sự kiện mẫu"
                                Command="{Binding EmitDemoSamplesCommand}"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource FilterPillButtonStyle}"
                                Height="26"
                                Padding="10,0"
                                Margin="8,0,0,0"
                                FontSize="11"
                                ToolTip="Phát các sự kiện mẫu (Đơn mới, Nhận kiện, Trùng, Ghi chú, Sửa, Xóa, Ảnh, Lỗi) không chạm DB/mạng" />
                    </StackPanel>
                    <TextBlock Text="Nhận mã vận đơn quét từ điện thoại qua MQTT theo mã phòng."
                               FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Weak Room Red Warning -->
        <Border Grid.Row="1"
                Margin="20,14,20,0"
                Background="{DynamicResource AlertRedBadgeBgBrush}"
                BorderBrush="{DynamicResource AlertRedBorderStrongBrush}"
                BorderThickness="1.5"
                CornerRadius="10"
                Padding="16,12"
                Visibility="{Binding IsRoomWeak, Converter={StaticResource BoolToVis}}">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Tạo mã mạnh"
                        Command="{Binding CreateStrongRoomCommand}"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Background="#DC2626"
                        Height="34"
                        Padding="14,0"
                        VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⚠️ Mã phòng quá yếu, người lạ có thể đoán"
                               Foreground="{DynamicResource AlertRedDarkTextBrush}"
                               FontSize="14"
                               FontWeight="Bold" />
                    <TextBlock Text="Khuyến nghị dùng mã ngẫu nhiên tối thiểu 16 ký tự và không dùng mã mặc định cũ."
                               Foreground="{DynamicResource AlertRedTextBrush}"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="2" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Room Code + Connection Status + Phone Instructions -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                <!-- Room Code Card -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="MÃ PHÒNG ĐỒNG BỘ" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,0,8" />
                        <Border Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                            <TextBlock Text="{Binding Room}"
                                       FontFamily="Consolas"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource InkPrimaryBrush}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="📋 Sao chép"
                                    Command="{Binding CopyRoomCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Height="36"
                                    Padding="16,0"
                                    Margin="0,0,10,0" />
                            <Button Content="🔄 Tạo mã mới"
                                    Command="{Binding RegenerateRoomCommand}"
                                    Style="{StaticResource FilterPillButtonStyle}"
                                    Height="36"
                                    Padding="14,0" />
                            <TextBlock Text="{Binding CopiedNotice}"
                                       Foreground="{DynamicResource AlertGreenTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding HasCopiedNotice, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <Border Background="{DynamicResource AlertYellowCardBgBrush}" BorderBrush="{DynamicResource AlertYellowCardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="🔒 Danh sách đơn gửi sang điện thoại đi qua máy chủ công cộng không mã hóa; giữ bí mật mã phòng."
                                       Foreground="{DynamicResource AlertYellowDarkTextBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Connection & Switch Card -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,10">
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding SyncStateText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource InkSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="TRẠNG THÁI KẾT NỐI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkSecondaryBrush}" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="{Binding ConnectionStatusText}"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AlertRedTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- MQTT Channel -->
                        <Border BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AlertRedBadgeBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AlertRedCardBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MqttBgHex}" Value="#F1F5F9">
                                            <Setter Property="Background" Value="{DynamicResource NeutralBadgeBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource NeutralBadgeBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding MqttBgHex}" Value="#DCFCE7">
                                            <Setter Property="Background" Value="{DynamicResource AlertGreenBadgeBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AlertGreenCardBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding MqttStatusText}"
                                           FontSize="13"
                                           FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AlertRedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding MqttBgHex}" Value="#F1F5F9">
                                                    <Setter Property="Foreground" Value="{DynamicResource NeutralBadgeFgBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding MqttBgHex}" Value="#DCFCE7">
                                                    <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding MqttLastError}"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding HasMqttLastError, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- ntfy Channel -->
                        <Border BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,8"
                                Margin="0,0,0,10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource AlertRedBadgeBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource AlertRedCardBorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NtfyBgHex}" Value="#F1F5F9">
                                            <Setter Property="Background" Value="{DynamicResource NeutralBadgeBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource NeutralBadgeBorderBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NtfyBgHex}" Value="#DCFCE7">
                                            <Setter Property="Background" Value="{DynamicResource AlertGreenBadgeBgBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource AlertGreenCardBorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding NtfyStatusText}"
                                           FontSize="13"
                                           FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AlertRedTextBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NtfyBgHex}" Value="#F1F5F9">
                                                    <Setter Property="Foreground" Value="{DynamicResource NeutralBadgeFgBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NtfyBgHex}" Value="#DCFCE7">
                                                    <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding NtfyLastError}"
                                           Foreground="{DynamicResource InkMutedBrush}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Visibility="{Binding HasNtfyLastError, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>

                        <!-- ntfy Switch & Note -->
                        <CheckBox Content="Dùng ntfy (dự phòng)"
                                  IsChecked="{Binding NtfyEnabled, Mode=OneWay}"
                                  Command="{Binding ToggleNtfyCommand}"
                                  FontSize="13"
                                  FontWeight="SemiBold"
                                  Foreground="{DynamicResource InkPrimaryBrush}"
                                  Cursor="Hand" />
                        <TextBlock Text="Một số mạng chặn ntfy.sh; khi đó chỉ MQTT hoạt động."
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Broker riêng -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="MÁY CHỦ MQTT RIÊNG (khuyên dùng)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBox x:Name="PrivateBrokerBox" Text="{Binding PrivateBrokerText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="12.5" Padding="6,5" />
                        <TextBlock Text="Dạng wss://tên:mật-khẩu@may-chu.example.com/mqtt. Để trống = dùng 3 broker công cộng. Điện thoại phải nhập cùng địa chỉ."
                                   Foreground="{DynamicResource InkMutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Lưu và kết nối lại" Command="{Binding SavePrivateBrokerCommand}" Padding="12,5" Margin="0,0,8,0" />
                            <Button Content="Về broker công cộng" Command="{Binding ClearPrivateBrokerCommand}" Padding="12,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Phone Setup Info -->
                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="THÔNG TIN NHẬP VÀO ĐIỆN THOẠI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,0,8" />
                        <TextBlock Text="Trang quét điện thoại cũ vẫn dùng được: mở mobile_scanner, nhập đúng mã phòng này"
                                   Foreground="{DynamicResource InkPrimaryBrush}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <Border Background="{DynamicResource SurfaceSubtleBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                            <TextBlock FontSize="12.5" Foreground="{DynamicResource InkTertiaryBrush}">
                                <Run Text="Mã phòng: " FontWeight="SemiBold" />
                                <Run Text="{Binding Room, Mode=OneWay}" FontFamily="Consolas" FontWeight="Bold" />
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Đơn quét từ điện thoại vào thẳng Bảng chính với trạng thái 'Chưa trả', ghi chú 'Đơn mới tạo từ máy quét điện thoại'. Tạo đơn hủy từ điện thoại không còn."
                                   Foreground="{DynamicResource InkSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Received Logs -->
            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="Tối đa 200 dòng" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="NHẬT KÝ NHẬN TỪ ĐIỆN THOẠI" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource InkSecondaryBrush}" />
                        </DockPanel>
                        <TextBlock Text="{Binding NewOrdersTodayText}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AlertGreenTextBrush}"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Grid>
                        <TextBlock Text="Chưa có lượt nhận nào từ điện thoại trong phiên này."
                                   Foreground="{DynamicResource InkSubtleBrush}"
                                   FontSize="12.5"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLogs}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Logs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8"
                                                Padding="10,8"
                                                Margin="0,0,0,8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="Background" Value="{DynamicResource AlertRedBadgeBgBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AlertRedCardBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BgHex}" Value="#DCFCE7">
                                                            <Setter Property="Background" Value="{DynamicResource AlertGreenBadgeBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AlertGreenCardBorderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BgHex}" Value="#FEF3C7">
                                                            <Setter Property="Background" Value="{DynamicResource AlertYellowBadgeBgBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AlertYellowCardBorderBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsNewOrder}" Value="True">
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding TimeText}"
                                                           FontFamily="Consolas"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource InkMutedBrush}"
                                                           Margin="8,0,0,0" />
                                                <StackPanel>
                                                    <WrapPanel Orientation="Horizontal">
                                                        <Border Background="{DynamicResource SurfaceMutedBgBrush}"
                                                                BorderBrush="{DynamicResource BorderBrushStrong}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="6,1"
                                                                Margin="0,0,6,0"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="📥 "
                                                                           FontSize="11"
                                                                           Visibility="{Binding IsNewOrder, Converter={StaticResource BoolToVis}}" />
                                                                <TextBlock Text="{Binding StageLabel}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="{DynamicResource InkPrimaryBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <TextBlock Text="{Binding Code}"
                                                                   FontFamily="Consolas"
                                                                   FontWeight="Bold"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource InkPrimaryBrush}"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding OutcomeLabel}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11.5"
                                                                   VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AlertRedTextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding BgHex}" Value="#DCFCE7">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding BgHex}" Value="#FEF3C7">
                                                                            <Setter Property="Foreground" Value="{DynamicResource AlertYellowTextBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding Message}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource InkSecondaryBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
