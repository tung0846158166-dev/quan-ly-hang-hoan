<UserControl x:Class="QuanLyHangHoan.App.Views.DeletedOrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             xmlns:ctl="clr-namespace:QuanLyHangHoan.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DeletedOrdersViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="↺ Xóa bộ lọc"
                        Command="{Binding ResetAllFiltersCommand}"
                        Style="{StaticResource FilterPillButtonStyle}"
                        VerticalAlignment="Center"
                        Margin="0" />
                <Button DockPanel.Dock="Right" Content="{Binding Filters.ButtonText}" Command="{Binding Filters.TogglePanelCommand}" Style="{StaticResource FilterPillButtonStyle}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Lọc theo sản phẩm và khoảng ngày" />
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗑️ Đơn đã xóa (Chống nạp lại)" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Border Background="{DynamicResource SurfaceSubtleBgBrush}" BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DỮ LIỆU GIẢ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource InkSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Lưu vết các đơn đã xóa để không bị tạo lại ngoài ý muốn khi nạp file Excel hoặc đồng bộ Google Sheet." FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
                <WrapPanel Margin="0,10,0,0" Visibility="{Binding Filters.ShowPanel, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Sản phẩm:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,6,0" />
                    <TextBox Text="{Binding Filters.ProductFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="200" Height="30" VerticalContentAlignment="Center" FontSize="12" Margin="0,0,14,0" ToolTip="Gõ một phần tên sản phẩm (không cần dấu)" />
                    <TextBlock Text="{Binding Filters.DateLabel, StringFormat='{}{0} từ:'}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding Filters.DateFrom}" Width="120" Height="30" FontSize="12" Margin="0,0,8,0" />
                    <TextBlock Text="đến:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,6,0" />
                    <DatePicker SelectedDate="{Binding Filters.DateTo}" Width="120" Height="30" FontSize="12" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Search, Source Table Filter, Sort -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Command="{Binding SetSourceFilterCommand}" CommandParameter="all">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSourceAll}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding TotalCount, StringFormat='Tất cả ({0:N0})'}" />
                    </Button>
                    <Button Command="{Binding SetSourceFilterCommand}" CommandParameter="Bảng chính">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSourceMain}" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding MainTableCount, StringFormat='Bảng chính ({0:N0})'}" />
                    </Button>
                    <Button Command="{Binding SetSourceFilterCommand}" CommandParameter="Kho lưu trữ" Margin="0,0,10,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSourceArchive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AlertGreenTextBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AlertGreenTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding ArchiveTableCount, StringFormat='Lưu trữ ({0:N0})'}" />
                    </Button>
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="all">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformAll}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="🌐 Cả 2 sàn" />
                    </Button>
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="Shopee">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformShopee}" Value="True">
                                        <Setter Property="Background" Value="#EE4D2D" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#EE4D2D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding ShopeeCount, StringFormat='🟠 Shopee ({0:N0})'}" />
                    </Button>
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="TikTok" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformTikTok}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TikTokBadgeBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource TikTokBadgeBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding TikTokCount, StringFormat='⚫ TikTok ({0:N0})'}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Sắp xếp:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption}"
                              DisplayMemberPath="Label"
                              Width="205"
                              Height="32"
                              VerticalContentAlignment="Center"
                              FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid + Empty State -->
        <Grid Grid.Row="2" Margin="14,10">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <DataGrid x:Name="DeletedGrid"
                          ItemsSource="{Binding VisibleOrders}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          PreviewKeyDown="DeletedGrid_PreviewKeyDown"
                          MouseDoubleClick="DeletedGrid_MouseDoubleClick"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                          BorderThickness="0"
                          Background="{DynamicResource CardBgBrush}"
                          RowHeight="36"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          VirtualizingPanel.CacheLength="1,1"
                          ScrollViewer.CanContentScroll="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                          CellStyle="{StaticResource ModernDataGridCellStyle}">
                    <DataGrid.Resources>
                        <ContextMenu x:Key="DeletedRowContextMenu">
                            <MenuItem Header="🔍 Xem chi tiết"
                                      FontWeight="SemiBold"
                                      Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="↩ Khôi phục"
                                      Command="{Binding DataContext.RestoreRowCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="📜 Xem lịch sử sửa"
                                      Command="{Binding DataContext.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{DynamicResource DataGridRowBgBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
                            <Setter Property="ContextMenu" Value="{StaticResource DeletedRowContextMenu}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="56">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderId}" Width="145">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="12.5" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Sàn" Width="98" SortMemberPath="Platform">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Platform, Converter={StaticResource PlatformBrushConverter}}"
                                            CornerRadius="5" Padding="7,2" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Platform}"
                                                   Foreground="{Binding Platform, Converter={StaticResource PlatformBrushConverter}, ConverterParameter=Foreground}"
                                                   FontSize="11" FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mã vận đơn" Binding="{Binding DisplayTracking}" Width="155">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ItemsSummary}" Width="245">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding ItemsSummary}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Xóa từ" Binding="{Binding DeletedFrom}" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Thời điểm xóa" Binding="{Binding DeletedAt}" Width="140" SortMemberPath="DeletedAtParsed" />
                        <DataGridTextColumn Header="Lý do / Ghi chú" Binding="{Binding DeleteReason}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding DeleteReason}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Thao tác" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="↩ Khôi phục"
                                                Command="{Binding DataContext.RestoreRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryActionButtonStyle}"
                                                Background="#16A34A"
                                                Padding="9,3"
                                                FontSize="11.5"
                                                Margin="0,0,6,0"
                                                ToolTip="Khôi phục đơn về bảng trước khi xóa" />
                                        <Button Content="•••"
                                                Click="RowActionButton_Click"
                                                Style="{StaticResource FilterPillButtonStyle}"
                                                Padding="7,2"
                                                Margin="0"
                                                ToolTip="Mở menu thao tác" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Empty State -->
            <Border Background="{DynamicResource SurfaceMutedBgBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="🗑️" FontSize="38" HorizontalAlignment="Center" />
                    <TextBlock Text="Không có đơn đã xóa nào khớp bộ lọc" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,4" />
                    <TextBlock Text="Thử xóa từ khóa hoặc chọn lại nguồn Tất cả." FontSize="12.5" Foreground="{DynamicResource InkMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <Button Content="✕ Xóa bộ lọc" Command="{Binding ResetAllFiltersCommand}" Style="{StaticResource PrimaryActionButtonStyle}" Background="#EE4D2D" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="#0F172A" Padding="18,8">
            <DockPanel><ctl:PagerBar DockPanel.Dock="Right" DataContext="{Binding Pager}" Margin="18,0,0,0" />
            <TextBlock Text="{Binding StatusBarText}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" /></DockPanel>
        </Border>
    </Grid>
</UserControl>
