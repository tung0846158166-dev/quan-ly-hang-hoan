<UserControl x:Class="QuanLyHangHoan.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HelpViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <Style x:Key="HelpTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="HelpHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="❓ Trợ giúp" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                    <Border Margin="12,0,0,0" Padding="8,2" CornerRadius="10" VerticalAlignment="Center"
                            Background="{DynamicResource AlertYellowBadgeBgBrush}"
                            Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="DỮ LIỆU GIẢ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AlertYellowTextBrush}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding VersionText}" Style="{StaticResource HelpHint}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel MaxWidth="900" HorizontalAlignment="Left">

                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🚀 Bắt đầu nhanh" Style="{StaticResource HelpTitle}" />
                        <ItemsControl ItemsSource="{Binding Steps}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Mark}" FontSize="16" FontWeight="Bold" VerticalAlignment="Top">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Done}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource InkPrimaryBrush}">
                                                <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding Title, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource HelpHint}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Đi tới" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                                                Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding TargetKey}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="🩺 Chẩn đoán (để gửi cho người hỗ trợ)" Style="{StaticResource HelpTitle}" />
                        <TextBlock Style="{StaticResource HelpHint}" Margin="0,0,0,8"
                                   Text="Báo cáo không chứa mã vận đơn, tên sản phẩm hay thông tin khách. Bấm &quot;Sao chép tất cả&quot; rồi dán vào tin nhắn." />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Sao chép tất cả" Command="{Binding CopyAllCommand}" Padding="14,6" Cursor="Hand" />
                            <Button Content="Làm mới" Command="{Binding RefreshCommand}" Padding="14,6" Margin="8,0,0,0" Cursor="Hand" />
                            <Button Content="Mở thư mục dữ liệu" Command="{Binding OpenDataFolderCommand}" Padding="14,6" Margin="8,0,0,0" Cursor="Hand" />
                            <Button Content="Mở thư mục sao lưu" Command="{Binding OpenBackupFolderCommand}" Padding="14,6" Margin="8,0,0,0" Cursor="Hand" />
                        </StackPanel>
                        <TextBlock Text="{Binding CopyStatus}" Foreground="{DynamicResource AlertGreenTextBrush}" FontWeight="SemiBold" Margin="0,0,0,6"
                                   Visibility="{Binding CopyStatus, Converter={StaticResource StringNotEmptyToVis}}" />
                        <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True"
                                 FontFamily="Consolas" FontSize="12" MinHeight="220" MaxHeight="360" Padding="8"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource SurfaceMutedBgBrush}" Foreground="{DynamicResource InkPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderBrushLight}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DashboardCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="⌨️ Phím tắt" Style="{StaticResource HelpTitle}" />
                        <ItemsControl ItemsSource="{Binding Shortcuts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Keys}" FontFamily="Consolas" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Meaning}" TextWrapping="Wrap" Foreground="{DynamicResource InkPrimaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
