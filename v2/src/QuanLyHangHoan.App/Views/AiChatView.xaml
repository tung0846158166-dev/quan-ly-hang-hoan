<UserControl x:Class="QuanLyHangHoan.App.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             xmlns:local="clr-namespace:QuanLyHangHoan.App.Views"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AiChatViewModel}"
             UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <!-- Nút trên thanh tiêu đề: chữ trắng, nền mờ khi rê chuột -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="#26FFFFFF" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#47FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chữ trong bong bóng: người dùng chữ trắng, AI chữ thường -->
        <Style x:Key="BubbleText" TargetType="local:ChatMarkdownView">
            <Setter Property="TextBrush" Value="{DynamicResource InkPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="TextBrush" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="TextBrush" Value="#991B1B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BubbleBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="4,14,14,14" />
            <Setter Property="Background" Value="{DynamicResource SurfaceMutedBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter Property="CornerRadius" Value="14,4,14,14" />
                    <Setter Property="Background" Value="#4F46E5" />
                    <Setter Property="BorderBrush" Value="#4F46E5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Background" Value="#FEE2E2" />
                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Thẻ đơn liên quan: không bị cắt chữ -->
        <Style x:Key="OrderChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Padding="10,7" Margin="0,0,0,5"
                                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#6366F1" />
                                <Setter TargetName="Bg" Property="Background" Value="#EEF2FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource CardBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề -->
        <Border Grid.Row="0" Padding="14,11">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#4F46E5" Offset="0" />
                    <GradientStop Color="#8B5CF6" Offset="0.65" />
                    <GradientStop Color="#EC4899" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding ClosePanelCommand}" Width="30" Height="30" Style="{StaticResource HeaderButton}" ToolTip="Đóng" />
                <Button DockPanel.Dock="Right" Content="Mới" Command="{Binding NewChatCommand}" Padding="12,5" Margin="0,0,8,0" Style="{StaticResource HeaderButton}" ToolTip="Bắt đầu cuộc trò chuyện mới" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="✨ Hỏi AI về đơn hàng" FontSize="15" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="Chỉ đọc dữ liệu · Tên, SĐT, địa chỉ người nhận được ẩn" FontSize="11" Foreground="#E0E7FF" Margin="0,1,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Chưa có khóa API -->
        <Border Grid.Row="1" Margin="12,10,12,0" Padding="12,10" CornerRadius="8" Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1"
                Visibility="{Binding NeedsKey, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Chưa có khóa API. Hãy nhập khóa Groq và/hoặc Google trong Cài đặt." TextWrapping="Wrap" FontSize="12.5" Foreground="#78350F" />
                <Button Content="Mở Cài đặt trợ lý AI" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0" Cursor="Hand" />
            </StackPanel>
        </Border>

        <!-- Hội thoại -->
        <ScrollViewer Grid.Row="2" x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="0">
            <StackPanel Margin="12,6,12,8">
                <!-- Màn chào -->
                <StackPanel Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                    <TextBlock Text="✨" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Bạn muốn biết gì về đơn hàng?" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource InkPrimaryBrush}" Margin="0,4,0,14" />
                    <ItemsControl ItemsSource="{Binding Suggestions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.AskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Short}" Style="{StaticResource OrderChip}" ToolTip="{Binding Meaning}">
                                    <TextBlock FontSize="12.5" Foreground="{DynamicResource InkPrimaryBrush}" TextWrapping="Wrap">
                                        <Run Text="{Binding Short, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="·" Foreground="{DynamicResource InkMutedBrush}" />
                                        <Run Text="{Binding Meaning, Mode=OneWay}" Foreground="{DynamicResource InkMutedBrush}" />
                                    </TextBlock>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding InputHint}" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="8,10,8,0" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,7,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Hình đại diện AI -->
                                <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top" Margin="0,0,8,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6366F1" Offset="0" />
                                            <GradientStop Color="#EC4899" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="✨" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <StackPanel Grid.Column="1" MaxWidth="340">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Style="{StaticResource BubbleBorder}" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Sao chép" Command="{Binding PlacementTarget.Tag.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                          CommandParameter="{Binding}" />
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <local:ChatMarkdownView Markdown="{Binding Text}" Style="{StaticResource BubbleText}" />
                                    </Border>

                                    <!-- Đơn liên quan -->
                                    <TextBlock Text="{Binding RefsHeader}" FontSize="11" FontWeight="SemiBold" Margin="2,8,0,5"
                                               Foreground="{DynamicResource InkSecondaryBrush}"
                                               Visibility="{Binding HasRefs, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl ItemsSource="{Binding Refs}" Visibility="{Binding HasRefs, Converter={StaticResource BoolToVis}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource OrderChip}"
                                                        Command="{Binding DataContext.OpenRefCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                                                   Foreground="#166534" Background="#DCFCE7" Padding="6,2" VerticalAlignment="Center" />
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding OrderId}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource InkPrimaryBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Track}" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Giờ gửi / nhận -->
                                    <TextBlock Text="{Binding Caption}" FontSize="10.5" Margin="4,3,4,0"
                                               Foreground="{DynamicResource InkMutedBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Đang trả lời -->
                <Grid Margin="0,7,0,7" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Top" Margin="0,0,8,0" Background="#8B5CF6">
                        <TextBlock Text="✨" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="4,14,14,14" Padding="14,10" Width="150"
                            Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Đang trả lời…" FontSize="12.5" Foreground="{DynamicResource InkSecondaryBrush}" />
                            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,7,0,0" Foreground="#8B5CF6" Background="Transparent" BorderThickness="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Trạng thái (chỉ hiện khi có việc cần báo) -->
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Margin="16,4,16,2" FontSize="10.5" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" MaxHeight="70" />

        <!-- Ô nhập -->
        <Border Grid.Row="4" Margin="12,2,12,12" CornerRadius="22" BorderThickness="1.2" BorderBrush="{DynamicResource BorderBrushStrong}"
                Background="{DynamicResource CardBgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Padding="16,10" FontSize="13.5"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource InkPrimaryBrush}" CaretBrush="{DynamicResource InkPrimaryBrush}"
                         AcceptsReturn="False" VerticalContentAlignment="Center" IsEnabled="{Binding Available}" KeyDown="InputBox_KeyDown" />
                <TextBlock Text="Hỏi về đơn hàng... (gõ tắt được: đỏ, về hn, chờ sp)" IsHitTestVisible="False" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="13.5"
                           Foreground="{DynamicResource InkMutedBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Input}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Grid.Column="1" Command="{Binding SendCommand}" Width="34" Height="34" Margin="0,0,5,0" Cursor="Hand" ToolTip="Gửi (Enter)">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse x:Name="Disc" Fill="#4F46E5" />
                                <TextBlock Text="➤" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Disc" Property="Fill" Value="#CBD5E1" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Disc" Property="Fill" Value="#4338CA" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
