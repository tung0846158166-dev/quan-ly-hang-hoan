<UserControl x:Class="QuanLyHangHoan.App.Views.ReceivedStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReceivedStockViewModel}"
             UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <!-- Hàng hoàn sẵn kho (chủ dự án 27/11/2026): hàng hoàn đã nhận tại kho gần đây; có đơn mới trùng sản phẩm thì lấy đóng luôn, khỏi cất kệ. -->
    <UserControl.Resources>
        <Style x:Key="RangePill" TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,12">
            <StackPanel>
                <TextBlock Text="🧺 Hàng hoàn sẵn kho" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                <TextBlock Text="Sản phẩm của các kiện hoàn ĐÃ NHẬN tại kho. Có đơn mới trùng sản phẩm thì gõ tên ở đây (kèm màu/size cũng được), lấy luôn hàng hoàn để đóng đơn, khỏi cất lên kệ. Nhấp đúp để xem chi tiết kiện."
                           FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,9">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Nhận trong:" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="12,0,8,0" />
                    <Button Command="{Binding SetRangeCommand}" CommandParameter="today" Content="Hôm nay">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetRangeCommand}" CommandParameter="3d" Content="3 ngày">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Is3Days}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetRangeCommand}" CommandParameter="7d" Content="7 ngày">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Is7Days}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Command="{Binding SetRangeCommand}" CommandParameter="30d" Content="30 ngày" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Is30Days}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" /><Setter Property="Foreground" Value="#FFFFFF" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔎" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}" Width="360" Padding="8,6" FontSize="13"
                             AutomationProperties.Name="Tìm sản phẩm sẵn kho" ToolTip="Gõ tên sản phẩm, có thể thêm màu / size (không dấu cũng được), ví dụ: ao thun den L" />
                    <Button Content="✕" Command="{Binding ClearSearchCommand}" Margin="4,0,0,0" Padding="8,4" ToolTip="Xóa ô tìm" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" Margin="14,10,14,10">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}" MouseDoubleClick="Grid_MouseDoubleClick"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                          BorderThickness="0" Background="{DynamicResource CardBgBrush}" MinRowHeight="36"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}" CellStyle="{StaticResource ModernDataGridCellStyle}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding AllCodes}" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sản phẩm" Binding="{Binding Product}" Width="*" MinWidth="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Màu" Binding="{Binding Color}" Width="120" />
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" />
                        <DataGridTextColumn Header="SL sẵn" Binding="{Binding Units}" Width="70">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="#16A34A" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Nhận gần nhất" Binding="{Binding LastReceived}" Width="110" SortMemberPath="Source.LastReceived" />
                        <DataGridTextColumn Header="Sàn" Binding="{Binding Platform}" Width="110" />
                        <DataGridTextColumn Header="Kiện chứa hàng (mã vận đơn · số cái) — rê chuột để xem hết" Binding="{Binding Codes}" Width="2*" MinWidth="260">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas" /><Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,1,0,0" Padding="18,7">
            <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="{DynamicResource InkSecondaryBrush}" />
        </Border>
    </Grid>
</UserControl>
