<UserControl x:Class="QuanLyHangHoan.App.Views.WatchlistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             xmlns:ctl="clr-namespace:QuanLyHangHoan.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WatchlistViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Screen Title -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="True">
                <CheckBox DockPanel.Dock="Right"
                          Content="Gồm cả kho lưu trữ"
                          IsChecked="{Binding IncludeArchived, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          FontSize="12.5"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource InkPrimaryBrush}"
                          Cursor="Hand"
                          ToolTip="Hiển thị thêm các đơn đang theo dõi đã dời vào Kho lưu trữ" />

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⭐ Đang theo dõi" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Border Background="{DynamicResource DemoBadgeBgBrush}" BorderBrush="{DynamicResource DemoBadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DỮ LIỆU GIẢ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DemoBadgeFgBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Danh sách các kiện được đánh dấu theo dõi từ bảng chính &amp; đơn hủy (nhấp đúp hoặc Enter để xem chi tiết)"
                               FontSize="12"
                               Foreground="{DynamicResource InkMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: Quick Search + Platform Filter -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="all">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformAll}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding TotalCount, StringFormat='🌐 Tất cả ({0:N0})'}" />
                    </Button>

                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="Shopee">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformShopee}" Value="True">
                                        <Setter Property="Background" Value="#EE4D2D" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#EE4D2D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding ShopeeCount, StringFormat='🟠 Shopee ({0:N0})'}" />
                    </Button>

                    <Button Command="{Binding SetPlatformFilterCommand}" CommandParameter="TikTok" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlatformTikTok}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource TikTokBadgeBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource TikTokBadgeBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding TikTokCount, StringFormat='⚫ TikTok ({0:N0})'}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 2: DataGrid + Empty State -->
        <Grid Grid.Row="2" Margin="14,10,14,10">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <DataGrid x:Name="WatchlistGrid"
                          ItemsSource="{Binding VisibleOrders}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          PreviewKeyDown="WatchlistGrid_PreviewKeyDown"
                          MouseDoubleClick="WatchlistGrid_MouseDoubleClick"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                          BorderThickness="0"
                          Background="{DynamicResource CardBgBrush}"
                          MinRowHeight="36"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                          CellStyle="{StaticResource ModernDataGridCellStyle}">

                    <DataGrid.Resources>
                        <ContextMenu x:Key="WatchlistRowMenu">
                            <MenuItem Header="🔍 Xem chi tiết"
                                      FontWeight="SemiBold"
                                      Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="🔄 Đổi trạng thái..."
                                      Command="{Binding DataContext.ChangeStatusCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="✏️ Sửa lý do theo dõi..."
                                      Command="{Binding DataContext.EditWatchlistReasonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="⭐ Bỏ theo dõi"
                                      Command="{Binding DataContext.RemoveFromWatchlistCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="📜 Xem lịch sử sửa"
                                      Command="{Binding DataContext.ShowHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AlertDataGridRowStyle}">
                            <Setter Property="ContextMenu" Value="{StaticResource WatchlistRowMenu}" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="52">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Sàn" Width="92" SortMemberPath="Platform">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Platform, Converter={StaticResource PlatformBrushConverter}}"
                                            CornerRadius="5"
                                            Padding="7,2"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Platform}"
                                                   Foreground="{Binding Platform, Converter={StaticResource PlatformBrushConverter}, ConverterParameter=Foreground}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Mã đơn hàng" Binding="{Binding OrderId}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Mã vận đơn" Binding="{Binding DisplayTracking}" Width="220">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding DisplayTracking}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Sản phẩm" Width="220" SortMemberPath="ItemsSummary">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ctl:ItemLinesTextBlock Lines="{Binding ItemLines}" Chip="{Binding PartialChip}" ToolTip="{Binding ItemsTooltip}" Margin="6,0" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Nhận tại kho" Width="125" SortMemberPath="Status">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusBrushConverter}}"
                                            CornerRadius="5"
                                            Padding="8,2"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrushConverter}, ConverterParameter=Foreground}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Cảnh báo" Width="155" SortMemberPath="AlertPriority">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding AlertLevel, Converter={StaticResource AlertBadgeBrushConverter}}"
                                            CornerRadius="5"
                                            Padding="7,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AlertBadgeText}"
                                                   Foreground="{Binding AlertLevel, Converter={StaticResource AlertBadgeBrushConverter}, ConverterParameter=Foreground}"
                                                   FontSize="11.5"
                                                   FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Lý do theo dõi" Binding="{Binding WatchlistReason}" Width="240">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding WatchlistReason}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Vị trí" Binding="{Binding LocationLabel}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                    <Setter Property="FontSize" Value="11.5" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Thao tác" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="•••"
                                            Click="RowActionButton_Click"
                                            Style="{StaticResource FilterPillButtonStyle}"
                                            Padding="8,2"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            ToolTip="Mở menu thao tác trên dòng (hoặc chuột phải)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Empty State Overlay -->
            <Border Background="{DynamicResource SurfaceMutedBgBrush}"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrushLight}"
                    BorderThickness="1"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="⭐" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Chưa theo dõi đơn nào"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource InkPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,4" />
                    <TextBlock Text="Đánh dấu theo dõi từ menu thao tác trên từng đơn hàng để theo dõi tập trung tại đây."
                               FontSize="12.5"
                               Foreground="{DynamicResource InkMutedBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 3: Bottom Status Bar -->
        <Border Grid.Row="3" Background="#0F172A" Padding="18,8">
            <DockPanel><ctl:PagerBar DockPanel.Dock="Right" DataContext="{Binding Pager}" Margin="18,0,0,0" /><TextBlock Text="{Binding StatusBarText}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" /></DockPanel>
        </Border>
    </Grid>
</UserControl>
