<Window ShowInTaskbar="False" x:Class="QuanLyHangHoan.App.Views.PhotoViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PhotoViewerViewModel}"
        Title="{Binding Title}"
        Width="860"
        Height="680"
        MinWidth="540"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#0F172A"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header & Zoom Toolbar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➖"
                            Command="{Binding ZoomOutCommand}"
                            ToolTip="Thu nhỏ"
                            Background="#334155"
                            Foreground="#F8FAFC"
                            BorderThickness="0"
                            Padding="10,6"
                            Margin="0,0,4,0"
                            Cursor="Hand" />
                    <Border Background="#0F172A" CornerRadius="4" Padding="10,6" Margin="0,0,4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ZoomPercentText}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                    <Button Content="➕"
                            Command="{Binding ZoomInCommand}"
                            ToolTip="Phóng to"
                            Background="#334155"
                            Foreground="#F8FAFC"
                            BorderThickness="0"
                            Padding="10,6"
                            Margin="0,0,4,0"
                            Cursor="Hand" />
                    <Button Content="100%"
                            Command="{Binding ResetZoomCommand}"
                            ToolTip="Đặt lại kích thước"
                            Background="#334155"
                            Foreground="#F8FAFC"
                            BorderThickness="0"
                            Padding="10,6"
                            Margin="0,0,10,0"
                            Cursor="Hand" />
                    <Button Content="Đóng (Esc)"
                            Click="CloseButton_Click"
                            Background="#DC2626"
                            Foreground="#FFFFFF"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Padding="12,6"
                            Cursor="Hand" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Title}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" Foreground="#94A3B8" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Image Canvas -->
        <Grid Grid.Row="1" Background="#0F172A">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                    <Image Source="{Binding ImageSource}"
                           Stretch="None"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}" />
                        </Image.LayoutTransform>
                    </Image>
                </Grid>
            </ScrollViewer>

            <!-- Loading State -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="⏳" FontSize="34" HorizontalAlignment="Center" />
                <TextBlock Text="Đang tải ảnh từ kho dữ liệu..."
                           Foreground="#CBD5E1"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
            </StackPanel>

            <!-- Missing State -->
            <Border Background="#1E293B"
                    BorderBrush="#475569"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="440"
                    Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🖼️" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding MissingMessage}"
                               Foreground="#FCA5A5"
                               FontSize="16"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,10,0,4" />
                    <TextBlock Text="Tệp ảnh không còn tồn tại trong thư mục ảnh hoặc dữ liệu nhúng."
                               Foreground="#94A3B8"
                               FontSize="12"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- InlineDiffers Notice Footer -->
        <Border Grid.Row="2"
                Background="#422006"
                BorderBrush="#854D0E"
                BorderThickness="0,1,0,0"
                Padding="16,8"
                Visibility="{Binding ShowInlineDiffersNote, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding InlineDiffersNote, StringFormat='ℹ️ {0}'}"
                       Foreground="#FDE047"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</Window>
