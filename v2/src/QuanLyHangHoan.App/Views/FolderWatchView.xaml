<UserControl x:Class="QuanLyHangHoan.App.Views.FolderWatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FolderWatchViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RunNowCommand}"
                            Content="{Binding RunNowButtonText}"
                            IsEnabled="{Binding CanRunNow}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Background="#2563EB"
                            Height="34"
                            Padding="14,0"
                            Margin="0,0,8,0" />
                    <Button Command="{Binding RunExistingCommand}"
                            Content="{Binding RunExistingButtonText}"
                            IsEnabled="{Binding CanRunNow}"
                            Style="{StaticResource FilterPillButtonStyle}"
                            Height="34"
                            Padding="12,0" />
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📁 Theo dõi thư mục" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Border Background="{DynamicResource DemoBadgeBgBrush}" BorderBrush="{DynamicResource DemoBadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GIẢ LẬP (--demo)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DemoBadgeFgBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Tự động kiểm tra và nạp file đơn hoàn TikTok mới xuất vào thư mục (mỗi 15 giây)."
                               FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Folder, Status, Options, Fixed Note -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <!-- Empty State Guide when no folder selected -->
                    <Border Background="{DynamicResource InfoBlueCardBgBrush}"
                            BorderBrush="{DynamicResource InfoBlueCardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="16,12"
                            Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFolder}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Chưa chọn thư mục theo dõi"
                                       FontSize="13.5" FontWeight="Bold"
                                       Foreground="{DynamicResource InfoBlueStrongTextBrush}" />
                            <TextBlock Text="{Binding EmptyGuideText}"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource InfoBlueTextBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Folder Picker & Enable Toggle -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="THƯ MỤC THEO DÕI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" />
                            <Grid Margin="0,8,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding DisplayDirText, Mode=OneWay}"
                                         IsReadOnly="True"
                                         Background="{DynamicResource SurfaceMutedBgBrush}"
                                         Foreground="{DynamicResource InkPrimaryBrush}"
                                         BorderBrush="{DynamicResource InputBorderBrush}"
                                         BorderThickness="1"
                                         Padding="10,7"
                                         FontSize="12.5"
                                         VerticalContentAlignment="Center" />
                                <Button Grid.Column="2"
                                        Content="Chọn thư mục..."
                                        Command="{Binding BrowseFolderCommand}"
                                        Style="{StaticResource FilterPillButtonStyle}"
                                        Height="34"
                                        Padding="14,0" />
                            </Grid>

                            <CheckBox IsChecked="{Binding IsEnabled}"
                                      IsEnabled="{Binding HasFolder}"
                                      Content="Tự nạp file TikTok mới trong thư mục này"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource InkPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Last Run Status -->
                    <Border CornerRadius="10" BorderThickness="1" Padding="16,12" Margin="0,0,0,14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AlertGreenCardBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AlertGreenCardBorderBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AlertRedCardBgBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AlertRedCardBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="TRẠNG THÁI LƯỢT GẦN NHẤT" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" />
                            <TextBlock Text="{Binding LastStatusText}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,5,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AlertRedTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="TÙY CHỌN NẠP FILE TIKTOK" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,10" />

                            <TextBlock Text="Cột giá để lấy" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PriceModeOptions}"
                                      SelectedItem="{Binding SelectedPriceMode}"
                                      DisplayMemberPath="Label"
                                      Height="32"
                                      Margin="0,0,0,12" />

                            <TextBlock Text="Cách cập nhật sản phẩm" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ProductModeOptions}"
                                      SelectedItem="{Binding SelectedProductMode}"
                                      DisplayMemberPath="Label"
                                      Height="32"
                                      Margin="0,0,0,12" />

                            <CheckBox IsChecked="{Binding OnlyReturns}"
                                      Content="Chỉ nạp đơn hoàn/hủy/thất bại"
                                      FontSize="12.5"
                                      Foreground="{DynamicResource InkPrimaryBrush}"
                                      Margin="0,0,0,8" />

                            <CheckBox IsChecked="{Binding SkipUnshippedCancel}"
                                      Content="Bỏ đơn hủy chưa gửi"
                                      FontSize="12.5"
                                      Foreground="{DynamicResource InkPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Fixed Safety Note -->
                    <Border Background="{DynamicResource SurfaceMutedBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <TextBlock Text="{Binding FixedNoteText}"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource InkMutedBrush}"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: Run Log -->
            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="16">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="NHẬT KÝ CÁC LƯỢT CHẠY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" />
                        <TextBlock Text="Mới nhất trên cùng (tối đa 100 dòng)." FontSize="11.5" Foreground="{DynamicResource InkSubtleBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Grid>
                        <TextBlock Text="Chưa có lượt nạp nào trong phiên này."
                                   FontSize="12.5"
                                   Foreground="{DynamicResource InkSubtleBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLogs}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ListBox ItemsSource="{Binding Logs}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding HasLogs, Converter={StaticResource BoolToVis}}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" BorderThickness="1" Padding="10,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceMutedBgBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushLight}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AlertRedCardBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AlertRedCardBorderBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AlertYellowCardBgBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AlertYellowCardBorderBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <DockPanel LastChildFill="True">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" />
                                                <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AlertRedTextBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AlertYellowTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                            <TextBlock Text="{Binding FileNamesText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkPrimaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding SummaryText}" FontSize="11.5" Foreground="{DynamicResource InkSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
