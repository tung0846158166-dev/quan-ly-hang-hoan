<UserControl x:Class="QuanLyHangHoan.App.Views.SaleworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SaleworkViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RunNowCommand}"
                            Content="{Binding RunNowButtonText}"
                            IsEnabled="{Binding CanRunNow}"
                            ToolTip="{Binding WriteDisabledTooltip}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Background="#2563EB"
                            Height="34"
                            Padding="16,0" />
                    <Button Command="{Binding StopCommand}"
                            Content="Dừng"
                            IsEnabled="{Binding CanStop}"
                            Style="{StaticResource FilterPillButtonStyle}"
                            Height="34"
                            Padding="14,0"
                            Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛒 Salework" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Border Background="{DynamicResource DemoBadgeBgBrush}" BorderBrush="{DynamicResource DemoBadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="GIẢ LẬP (--demo)" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DemoBadgeFgBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Tự động lấy danh sách 'Đang chờ hoàn' kênh TikTok từ Salework (chạy tay bằng Lấy ngay)."
                               FontSize="12" Foreground="{DynamicResource InkMutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <StackPanel>
                    <!-- Account & Saved Page -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="CÀI ĐẶT TRANG ĐƠN HOÀN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,8" />

                            <Border Background="{DynamicResource SurfaceMutedBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrushLight}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,9"
                                    Margin="0,0,0,12">
                                <TextBlock Text="{Binding ConfigStatusText}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource InkPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <WrapPanel Orientation="Horizontal">
                                <Button Content="Đăng nhập Salework"
                                        Command="{Binding OpenLoginCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Background="#2563EB"
                                        Height="34"
                                        Padding="14,0"
                                        Margin="0,0,8,8" />
                                <Button Content="Lưu trang này"
                                        Command="{Binding SaveCurrentPageCommand}"
                                        IsEnabled="{Binding CanSaveCurrentPage}"
                                        Style="{StaticResource FilterPillButtonStyle}"
                                        Height="34"
                                        Padding="14,0"
                                        Margin="0,0,8,8" />
                                <Button Content="Quên đăng nhập"
                                        Command="{Binding ForgetCommand}"
                                        Style="{StaticResource FilterPillButtonStyle}"
                                        Height="34"
                                        Padding="14,0"
                                        Margin="0,0,0,8" />
                            </WrapPanel>

                            <TextBlock Text="{Binding ActionError}"
                                       Visibility="{Binding HasActionError, Converter={StaticResource BoolToVis}}"
                                       Foreground="#DC2626"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />

                            <TextBlock Text="{Binding ActionNotice}"
                                       Visibility="{Binding HasActionNotice, Converter={StaticResource BoolToVis}}"
                                       Foreground="{DynamicResource AlertGreenTextBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />

                            <CheckBox IsChecked="{Binding WatchMode}"
                                      Content="Chế độ xem (hiện cửa sổ, viền đỏ nút sắp bấm trước khi thao tác)"
                                      FontSize="12.5"
                                      FontWeight="SemiBold"
                                      Foreground="{DynamicResource InkPrimaryBrush}"
                                      Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Last Run Status -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="TRẠNG THÁI LƯỢT GẦN NHẤT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,8" />

                            <TextBlock Text="{Binding LastStatusText}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource InkPrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                                <Setter Property="Foreground" Value="#DC2626" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStatusSuccess}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Relogin Hint -->
                            <Border Visibility="{Binding ShowReloginHint, Converter={StaticResource BoolToVis}}"
                                    Background="#FEF2F2"
                                    BorderBrush="#FCA5A5"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,9"
                                    Margin="0,10,0,0">
                                <TextBlock Text="⚠️ Salework yêu cầu đăng nhập lại — bấm 'Đăng nhập Salework' để đăng nhập rồi thử lại."
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#B91C1C"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Ambiguous Warning -->
                            <Border Visibility="{Binding HasAmbiguousWarning, Converter={StaticResource BoolToVis}}"
                                    Background="#FEF3C7"
                                    BorderBrush="#F59E0B"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,9"
                                    Margin="0,10,0,0">
                                <TextBlock Text="{Binding AmbiguousWarningText}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#92400E"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 3-line Guide -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="HƯỚNG DẪN NHANH" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,8" />
                            <TextBlock Text="{Binding GuideText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource InkSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right Column: 100-line Log -->
            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" Padding="18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="NHẬT KÝ LẤY ĐƠN (TỐI ĐA 100 DÒNG)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource InkMutedBrush}" Margin="0,0,0,10" />

                    <TextBlock Grid.Row="1"
                               Text="Chưa có hoạt động nào."
                               FontSize="12.5"
                               Foreground="{DynamicResource InkMutedBrush}"
                               VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLogs}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Logs}"
                             Visibility="{Binding HasLogs, Converter={StaticResource BoolToVis}}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SaleworkLogEntry}">
                                <Border Background="{DynamicResource SurfaceMutedBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrushLight}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource InkMutedBrush}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsWarning}" Value="True">
                                                                <Setter Property="Foreground" Value="#D97706" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DockPanel>
                                        <TextBlock Text="{Binding SummaryText}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource InkPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
