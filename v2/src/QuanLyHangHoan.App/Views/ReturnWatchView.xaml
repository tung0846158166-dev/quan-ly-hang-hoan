<UserControl x:Class="QuanLyHangHoan.App.Views.ReturnWatchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QuanLyHangHoan.App.ViewModels"
             xmlns:ctl="clr-namespace:QuanLyHangHoan.App.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReturnWatchViewModel}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="🔄 Làm mới"
                        Command="{Binding RefreshDataCommand}"
                        Style="{StaticResource FilterPillButtonStyle}"
                        Margin="0"
                        VerticalAlignment="Center" />

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🚚 Hàng hoàn về" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
                        <Border Background="{DynamicResource DemoBadgeBgBrush}" BorderBrush="{DynamicResource DemoBadgeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="DỮ LIỆU GIẢ" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource DemoBadgeFgBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Theo dõi 4 chặng kiện hoàn tự động vào bảng từ trạng thái Đã đồng ý (nhấp đúp/Enter xem chi tiết, Del để bỏ khỏi bảng)"
                               FontSize="12"
                               Foreground="{DynamicResource InkMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: Search & Stage Filter Pills -->
        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="18,9">
            <StackPanel>

                <!-- Stage Filter Pills -->
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SetStageFilterCommand}" CommandParameter="tracking">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterTracking}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBtnBgBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding TrackingCount, StringFormat='🚚 Đang theo dõi ({0:N0})'}" />
                    </Button>

                    <Button Command="{Binding SetStageFilterCommand}" CommandParameter="stage1">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterStage1}" Value="True">
                                        <Setter Property="Background" Value="#2563EB" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding Stage1Count, StringFormat='1. Đã đồng ý ({0:N0})'}" />
                    </Button>

                    <Button Command="{Binding SetStageFilterCommand}" CommandParameter="stage2">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterStage2}" Value="True">
                                        <Setter Property="Background" Value="#0284C7" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#0284C7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding Stage2Count, StringFormat='2. Đang về ({0:N0})'}" />
                    </Button>

                    <Button Command="{Binding SetStageFilterCommand}" CommandParameter="stage3">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterStage3}" Value="True">
                                        <Setter Property="Background" Value="#D97706" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#D97706" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding Stage3Count, StringFormat='3. Đã về shop ({0:N0})'}" />
                    </Button>

                    <Button Command="{Binding SetStageFilterCommand}" CommandParameter="stage4">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterStage4}" Value="True">
                                        <Setter Property="Background" Value="#16A34A" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#16A34A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding Stage4Count, StringFormat='4. Đã nhận kho ({0:N0})'}" />
                    </Button>

                    <Button Command="{Binding SetStageFilterCommand}" CommandParameter="all" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource FilterPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFilterAll}" Value="True">
                                        <Setter Property="Background" Value="#475569" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="BorderBrush" Value="#475569" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding TotalCount, StringFormat='📋 Tất cả ({0:N0})'}" />
                    </Button>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Row 2: Multi-Select Action Bar & Overflow Banner -->
        <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource InfoBlueCardBgBrush}"
                    BorderBrush="{DynamicResource InfoBlueCardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,7"
                    Visibility="{Binding HasMultiSelection, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right"
                            Content="🗑️ Bỏ các dòng đã chọn khỏi bảng"
                            Command="{Binding RemoveFromBoardCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Background="#DC2626"
                            Padding="12,5"
                            FontSize="12" />
                    <TextBlock Text="{Binding SelectedRowCount, StringFormat='Đã chọn {0:N0} dòng (Ctrl/Shift để chọn nhiều, nhấn Del hoặc nút bên phải để bỏ khỏi bảng)'}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource InfoBlueStrongTextBrush}"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Background="{DynamicResource AlertYellowCardBgBrush}"
                    BorderBrush="{DynamicResource AlertYellowCardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="18,6"
                    Visibility="{Binding HasOverflow, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding OverflowMessage}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AlertYellowTextBrush}" />
            </Border>
        </StackPanel>

        <!-- Row 3: DataGrid + Empty State -->
        <Grid Grid.Row="3" Margin="14,10,14,10">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <DataGrid x:Name="ReturnWatchGrid"
                          ItemsSource="{Binding VisibleOrders}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          SelectionChanged="ReturnWatchGrid_SelectionChanged"
                          PreviewKeyDown="ReturnWatchGrid_PreviewKeyDown"
                          MouseDoubleClick="ReturnWatchGrid_MouseDoubleClick"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource DataGridGridLinesBrush}"
                          BorderThickness="0"
                          Background="{DynamicResource CardBgBrush}"
                          MinRowHeight="46"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          ColumnHeaderStyle="{StaticResource ModernDataGridHeaderStyle}"
                          CellStyle="{StaticResource ModernDataGridCellStyle}">

                    <DataGrid.Resources>
                        <ContextMenu x:Key="RowActionContextMenu">
                            <MenuItem Header="🔍 Xem chi tiết"
                                      FontWeight="SemiBold"
                                      Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="📋 Xem ở bảng chính"
                                      Command="{Binding DataContext.GoToMainTableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                            <Separator />
                            <MenuItem Header="🗑️ Bỏ khỏi bảng (Del)"
                                      Foreground="#DC2626"
                                      Command="{Binding DataContext.RemoveFromBoardCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                      CommandParameter="{Binding}" />
                        </ContextMenu>
                    </DataGrid.Resources>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource AlertDataGridRowStyle}">
                            <Setter Property="ContextMenu" Value="{StaticResource RowActionContextMenu}" />
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding Stt}" Width="48">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Cảnh báo (12h / 24h)" Width="140" SortMemberPath="AlertPriority">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding AlertLevel, Converter={StaticResource AlertBadgeBrushConverter}}"
                                            CornerRadius="5"
                                            Padding="7,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AlertBadgeText}"
                                                   Foreground="{Binding AlertLevel, Converter={StaticResource AlertBadgeBrushConverter}, ConverterParameter=Foreground}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Mã đơn" Binding="{Binding OrderId}" Width="115">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Foreground" Value="{DynamicResource InkPrimaryBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Sàn" Width="84" SortMemberPath="Platform">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Platform, Converter={StaticResource PlatformBrushConverter}}"
                                            CornerRadius="5"
                                            Padding="7,2"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Platform}"
                                                   Foreground="{Binding Platform, Converter={StaticResource PlatformBrushConverter}, ConverterParameter=Foreground}"
                                                   FontSize="11"
                                                   FontWeight="Bold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Mã vận đơn hoàn" Binding="{Binding DisplayTracking}" Width="145">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="FontSize" Value="12.5" />
                                    <Setter Property="Foreground" Value="{DynamicResource AlertGreenTextBrush}" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding DisplayTracking}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Sản phẩm" Width="175" SortMemberPath="ItemsSummary">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ctl:ItemLinesTextBlock Lines="{Binding ItemLines}" Chip="{Binding PartialChip}" ToolTip="{Binding ItemsTooltip}" Margin="6,0" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Giờ vào bảng" Binding="{Binding SinceFormatted}" Width="115" SortMemberPath="Since" />

                        <!-- Tiến trình 4 chặng + Sàn -->
                        <DataGridTemplateColumn Header="Tiến trình" Width="340" SortMemberPath="Stage">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Stage 1 -->
                                            <TextBlock Text="● Đã đồng ý" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStage1Done}" Value="True">
                                                                <Setter Property="Foreground" Value="#2563EB" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStage1Current}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text=" › " FontSize="11" Foreground="{DynamicResource InkSubtleBrush}" />

                                            <!-- Stage 2 -->
                                            <TextBlock Text="● Đang về" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStage2Done}" Value="True">
                                                                <Setter Property="Foreground" Value="#0284C7" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStage2Current}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text=" › " FontSize="11" Foreground="{DynamicResource InkSubtleBrush}" />

                                            <!-- Stage 3 -->
                                            <TextBlock Text="● Đã về shop" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStage3Done}" Value="True">
                                                                <Setter Property="Foreground" Value="#D97706" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStage3Current}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text=" › " FontSize="11" Foreground="{DynamicResource InkSubtleBrush}" />

                                            <!-- Stage 4 -->
                                            <TextBlock Text="● Đã nhận kho" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource InkSubtleBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsStage4Done}" Value="True">
                                                                <Setter Property="Foreground" Value="#16A34A" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsStage4Current}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding PlatformStatusLine}"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource InkMutedBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding PlatformStatusLine}"
                                                   Margin="0,1,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Giờ hàng về shop" Binding="{Binding ReturnedAt}" Width="125" SortMemberPath="ArrivedAtDate" />
                        <DataGridTextColumn Header="Ngày nhận kho" Binding="{Binding RecvDate}" Width="125" />

                        <DataGridTemplateColumn Header="Thao tác" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="•••"
                                            Click="RowActionButton_Click"
                                            Tag="{Binding}"
                                            Style="{StaticResource FilterPillButtonStyle}"
                                            Padding="8,2"
                                            Margin="0"
                                            HorizontalAlignment="Center"
                                            ToolTip="Mở menu thao tác trên dòng (hoặc chuột phải)" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Empty State Overlay -->
            <Border Background="{DynamicResource SurfaceMutedBgBrush}"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource BorderBrushLight}"
                    BorderThickness="1"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                    <TextBlock Text="🚚" FontSize="40" HorizontalAlignment="Center" />
                    <TextBlock Text="Chưa có đơn nào trong bảng này."
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource InkPrimaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,4" />
                    <TextBlock Text="Khi đơn có trạng thái sàn &quot;Đã đồng ý&quot;, kiện sẽ tự động vào bảng để theo dõi 4 chặng."
                               FontSize="12.5"
                               Foreground="{DynamicResource InkMutedBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Row 4: Status Bar -->
        <Border Grid.Row="4" Background="#0F172A" Padding="18,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cảnh báo Đỏ (chặng 3): " Foreground="#FCA5A5" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RedAlertCount, StringFormat='{}{0:N0}'}" Foreground="#FECACA" FontSize="12" FontWeight="Bold" Margin="0,0,14,0" />
                    <TextBlock Text="Cảnh báo Vàng (chặng 3): " Foreground="#FCD34D" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding YellowAlertCount, StringFormat='{}{0:N0}'}" Foreground="#FEF08A" FontSize="12" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="{Binding StatusBarText}" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
