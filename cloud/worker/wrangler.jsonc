{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qlhh-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "SHOP", "class_name": "ShopDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopDO"] }],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "app-images" }],
  "ai": { "binding": "AI" },
  // giờ UTC: 01:00/12:00/14:00 = 8:00/19:00/21:00 VN; 03:30/06:30/09:30 = 10:30/13:30/16:30 VN (gợi ý AI); 20:17 = dọn dẹp
  "triggers": { "crons": ["17 20 * * *", "0 1,12,14 * * *", "30 3,6,9 * * *"] },
  "vars": { "PHOTO_RETENTION_DAYS": "90" }
}


