<Window x:Class="QuanLyHangHoan.App.Views.NewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạo đơn mới"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>
    <Border Padding="22,18,22,18">
        <StackPanel>
            <TextBlock Text="➕ Tạo đơn mới" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource InkPrimaryBrush}" />
            <TextBlock Text="Đơn được thêm thẳng vào bảng chính và hiện ở Bảng đơn mới. Chỉ mã vận đơn là bắt buộc."
                       FontSize="12" Foreground="{DynamicResource InkMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />

            <TextBlock Text="Mã vận đơn *" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TrackBox" Style="{StaticResource FieldBox}" FontFamily="Consolas" FontSize="14" />
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource AlertRedTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Mã đơn hàng (không bắt buộc)" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="OrderIdBox" Style="{StaticResource FieldBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sàn" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PlatformBox" SelectedIndex="0" Padding="8,6" FontSize="13">
                        <ComboBoxItem Content="Tự nhận diện theo mã" Tag="" />
                        <ComboBoxItem Content="Shopee" Tag="Shopee" />
                        <ComboBoxItem Content="TikTok Shop" Tag="TikTok" />
                        <ComboBoxItem Content="Lazada" Tag="Lazada" />
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Text="Sản phẩm" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ProductBox" Style="{StaticResource FieldBox}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Màu" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ColorBox" Style="{StaticResource FieldBox}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Size" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SizeBox" Style="{StaticResource FieldBox}" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Số lượng" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="QtyBox" Style="{StaticResource FieldBox}" Text="1" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Đơn vị vận chuyển (không bắt buộc)" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="CarrierBox" Style="{StaticResource FieldBox}" />

            <TextBlock Text="Ghi chú" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="NoteBox" Style="{StaticResource FieldBox}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxHeight="100" VerticalScrollBarVisibility="Auto" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Hủy (Esc)" Padding="16,7" Margin="0,0,10,0" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="CreateButton" Content="Tạo đơn (Ctrl+Enter)" Padding="16,7" FontWeight="Bold" IsDefault="False" Click="Create_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
