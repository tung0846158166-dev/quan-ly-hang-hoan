<Window ShowInTaskbar="False" x:Class="QuanLyHangHoan.App.Views.ChangeStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đổi trạng thái nhận tại kho"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBgBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrushLight}"
            BorderThickness="1"
            CornerRadius="10"
            Margin="12"
            Padding="18">
        <StackPanel>
            <TextBlock Text="Đổi trạng thái nhận tại kho"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{DynamicResource InkPrimaryBrush}" />
            <TextBlock x:Name="OrderInfoText"
                       FontSize="12"
                       Foreground="{DynamicResource InkMutedBrush}"
                       Margin="0,4,0,6" />
            <Border Background="{DynamicResource SurfaceMutedBgBrush}"
                    BorderBrush="{DynamicResource BorderBrushLight}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,7"
                    Margin="0,0,0,12">
                <TextBlock x:Name="CurrentStatusText"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource InkSecondaryBrush}" />
            </Border>

            <TextBlock Text="Chọn trạng thái mới:"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource InkPrimaryBrush}"
                       Margin="0,0,0,8" />

            <StackPanel x:Name="StatusOptionsPanel" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy"
                        Click="CancelButton_Click"
                        Style="{StaticResource FilterPillButtonStyle}"
                        MinWidth="82"
                        Margin="0,0,8,0" />
                <Button Content="Lưu thay đổi"
                        Click="SaveButton_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Background="#2563EB"
                        MinWidth="110" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
