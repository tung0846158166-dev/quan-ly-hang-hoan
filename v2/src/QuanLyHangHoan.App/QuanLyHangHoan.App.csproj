<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\QuanLyHangHoan.Core\QuanLyHangHoan.Core.csproj" />
    <ProjectReference Include="..\QuanLyHangHoan.Data\QuanLyHangHoan.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Bản máy PHỤ (26/11/2026): dotnet publish -p:Edition=Secondary -> bỏ "Tạo mã ghép" + "Thiết bị đã ghép" (AppEdition.cs) -->
  <PropertyGroup Condition="'$(Edition)' == 'Secondary'">
    <DefineConstants>$(DefineConstants);SECONDARY</DefineConstants>
  </PropertyGroup>

</Project>
